#!/usr/bin/env bash
# bootstrap — report what is present, and install only what is asked for.
#
# There is deliberately very little to install. `ts` runs on a bare system
# python3 and its numbers are within ~1.5% of the exact tokenizer. tiktoken is
# offered, not required, and nothing here touches your Claude configuration.
#
# Usage: scripts/bootstrap [--check] [--yes]
set -uo pipefail

CHECK=0; YES=0
for a in "$@"; do
  case "$a" in
    --check) CHECK=1 ;;
    --yes|-y) YES=1 ;;
    -h|--help) sed -n '2,9p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) printf 'bootstrap: unknown option %s\n' "$a" >&2; exit 2 ;;
  esac
done

GREEN=$'\033[32m'; RED=$'\033[31m'; YEL=$'\033[33m'; DIM=$'\033[2m'; OFF=$'\033[0m'
[[ -t 1 ]] || { GREEN=; RED=; YEL=; DIM=; OFF=; }

MISSING=0

report() { # name state note
  local colour="$GREEN"
  case "$2" in
    missing) colour="$RED" ;;
    optional) colour="$YEL" ;;
  esac
  printf '  %-14s %s%-9s%s %s%s%s\n' "$1" "$colour" "$2" "$OFF" "$DIM" "${3:-}" "$OFF"
}

printf '\nrequired\n%s\n' "$(printf '%.0s-' {1..66})"
if command -v python3 >/dev/null 2>&1; then
  report python3 present "$(python3 -c 'import sys;print("%d.%d.%d"%sys.version_info[:3])')"
  if ! python3 -c 'import sys; sys.exit(0 if sys.version_info >= (3,9) else 1)'; then
    report python3 "too old" "3.9+ required"
    MISSING=1
  fi
else
  report python3 missing "install it from your OS; nothing here installs a system python"
  MISSING=1
fi

printf '\noptional\n%s\n' "$(printf '%.0s-' {1..66})"
if python3 -c 'import tiktoken' 2>/dev/null; then
  report tiktoken present "exact token counts"
else
  report tiktoken optional "estimates are within ~1.5%; install for exact counts"
fi

printf '\nknown third-party tools %s\n%s\n' "${DIM}(presence only — ts advise decides if any would help)${OFF}" "$(printf '%.0s-' {1..66})"
for t in rtk headroom repomix; do
  if command -v "$t" >/dev/null 2>&1; then
    report "$t" present "$(command -v "$t")"
  else
    report "$t" absent ""
  fi
done

if [[ $CHECK == 1 ]]; then
  printf '\n%s\n' "${DIM}--check: reported only, nothing installed${OFF}"
  exit $(( MISSING > 0 ))
fi

if ! python3 -c 'import tiktoken' 2>/dev/null; then
  printf '\n'
  if [[ $YES == 1 ]]; then
    reply=y
  else
    printf 'install tiktoken for exact token counts? [y/N] '
    read -r reply || reply=n
  fi
  case "$reply" in
    y|Y)
      if command -v uv >/dev/null 2>&1; then
        uv pip install tiktoken || pip3 install --user tiktoken
      else
        pip3 install --user tiktoken
      fi
      ;;
    *) printf '%s\n' "${DIM}skipped; estimates will be used${OFF}" ;;
  esac
fi

printf '\nnext: %s\n\n' "scripts/ts audit"
exit $(( MISSING > 0 ))
