#!/usr/bin/env bash
# verify — prove the numbers and the routing, against fixtures with known answers.
#
# Three things are checked, in order of how badly a regression would hurt:
#
#   1. ARITHMETIC  billed and content totals match values derived by hand in
#                  fixtures/EXPECTATIONS.json. Nothing here was recorded from
#                  program output.
#   2. ROUTING     the two Bash detectors are mutually exclusive across two
#                  deliberately opposite fleets. This is the central claim of
#                  the tool; if it breaks, the tool is giving generic advice.
#   3. SAFETY      malformed input degrades instead of crashing, and every
#                  mechanical fix is idempotent and reversible.
#
# Usage: scripts/verify [--keep]
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TS="$ROOT/scripts/ts"
FIX="$ROOT/fixtures"
KEEP=0
[[ ${1:-} == --keep ]] && KEEP=1

PASS=0; FAIL=0; SKIP=0
GREEN=$'\033[32m'; RED=$'\033[31m'; DIM=$'\033[2m'; YEL=$'\033[33m'; OFF=$'\033[0m'
[[ -t 1 ]] || { GREEN=; RED=; DIM=; YEL=; OFF=; }

ok()   { PASS=$((PASS+1)); printf '  %sPASS%s  %s\n' "$GREEN" "$OFF" "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  %sFAIL%s  %s\n' "$RED" "$OFF" "$1";
         [[ -n ${2:-} ]] && printf '        %s\n' "$2"; }
skip() { SKIP=$((SKIP+1)); printf '  %sSKIP%s  %s %s\n' "$YEL" "$OFF" "$1" "${DIM}${2:-}${OFF}"; }
head_() { printf '\n%s\n%s\n' "$1" "$(printf '%.0s-' {1..70})"; }

command -v python3 >/dev/null 2>&1 || { echo "verify: python3 required"; exit 2; }

TMP=$(mktemp -d)
cleanup() { [[ $KEEP == 1 ]] || rm -rf "$TMP"; }
trap cleanup EXIT

# Fixtures are generated, not committed as opaque blobs, so a reader can see
# exactly what produced the expected numbers.
"$FIX/build-fixtures" --out "$TMP" >/dev/null || { echo "verify: could not build fixtures"; exit 2; }

# ---------------------------------------------------------------------------
head_ "1. ARITHMETIC  (against hand-derived expectations)"
# ---------------------------------------------------------------------------
for fleet in chatter bulk; do
  out="$TMP/$fleet.json"
  if ! "$TS" audit --root "$TMP/$fleet" --json >"$out" 2>"$TMP/$fleet.err"; then
    bad "$fleet: audit --json failed" "$(head -3 "$TMP/$fleet.err")"
    continue
  fi
  result=$(python3 - "$FIX/EXPECTATIONS.json" "$out" "$fleet" <<'PY'
import json, sys
exp = json.load(open(sys.argv[1]))[sys.argv[3]]
got = json.load(open(sys.argv[2]))
bad = []
if got["turns"] != exp["turns"]:
    bad.append("turns %s != %s" % (got["turns"], exp["turns"]))
for k, v in exp["billed"].items():
    if got["billed"].get(k) != v:
        bad.append("billed.%s %s != %s" % (k, got["billed"].get(k), v))
for k, v in exp["bash"].items():
    g = got["bash"].get(k)
    # Content sizes are tokenizer-dependent; allow 5% on those, exact on counts.
    if k in ("calls",):
        if g != v:
            bad.append("bash.%s %s != %s" % (k, g, v))
    elif v and abs(g - v) / v > 0.05:
        bad.append("bash.%s %s not within 5%% of %s" % (k, g, v))
print("|".join(bad))
PY
)
  if [[ -z $result ]]; then
    ok "$fleet: billed totals and Bash distribution match expectations"
  else
    bad "$fleet: expectation mismatch" "${result//|/$'\n        '}"
  fi
done

# Amplification is the headline metric, so it gets its own check rather than
# riding along inside a bundle where a wrong value could hide.
amp=$("$TS" audit --root "$TMP/chatter" --json | python3 -c 'import json,sys;print(json.load(sys.stdin)["amplification"])')
exp_amp=$(python3 -c 'print(round(25020000/51540,1))' 2>/dev/null)
if python3 -c "import sys;sys.exit(0 if abs($amp-$exp_amp)/$exp_amp < 0.06 else 1)"; then
  ok "chatter: amplification ${amp}x matches 25,020,000 reads / content"
else
  bad "chatter: amplification ${amp}x, expected ~${exp_amp}x"
fi

# ---------------------------------------------------------------------------
head_ "2. ROUTING  (the same catalogue must give opposite advice)"
# ---------------------------------------------------------------------------
for fleet in chatter bulk; do
  adv="$TMP/$fleet.advise.json"
  if ! "$TS" advise --root "$TMP/$fleet" --json >"$adv" 2>/dev/null; then
    bad "$fleet: advise --json failed"
    continue
  fi
  result=$(python3 - "$FIX/EXPECTATIONS.json" "$adv" "$fleet" <<'PY'
import json, sys
exp = json.load(open(sys.argv[1]))[sys.argv[3]]
got = json.load(open(sys.argv[2]))
fired = {f["id"] for f in got["findings"]}
bad = []
for want in exp["fires"]:
    if want not in fired:
        bad.append("expected %s to fire" % want)
for quiet in exp["silent"]:
    if quiet in fired:
        bad.append("expected %s to stay silent" % quiet)
print("|".join(bad))
PY
)
  if [[ -z $result ]]; then
    ok "$fleet: fires ${DIM}$(python3 -c "import json;print(','.join(sorted(x['id'] for x in json.load(open('$adv'))['findings'])))")${OFF}"
  else
    bad "$fleet: wrong routing" "${result//|/$'\n        '}"
  fi
done

# The claim is not just "each fires somewhere" but "they never fire together".
both=$(python3 - "$TMP/chatter.advise.json" "$TMP/bulk.advise.json" <<'PY'
import json, sys
for p in sys.argv[1:]:
    ids = {f["id"] for f in json.load(open(p))["findings"]}
    if {"bash-chatter", "bash-bulk"} <= ids:
        print("both fired in %s" % p)
PY
)
[[ -z $both ]] && ok "bash-chatter and bash-bulk are mutually exclusive" \
                || bad "the two Bash detectors overlap" "$both"

# Severity must agree with the number it is derived from.
sev=$(python3 - "$TMP/chatter.advise.json" <<'PY'
import json, sys
bad = []
prev = None
for f in json.load(open(sys.argv[1]))["findings"]:
    if prev is not None and f["saving_pct"] > prev + 1e-9:
        bad.append("findings not sorted by saving_pct")
    prev = f["saving_pct"]
    want = "high" if f["saving_pct"] >= 8 else "medium" if f["saving_pct"] >= 2.5 else "low"
    if f["severity"] != want:
        bad.append("%s: severity %s but %.1f%% implies %s"
                   % (f["id"], f["severity"], f["saving_pct"], want))
print("|".join(bad))
PY
)
[[ -z $sev ]] && ok "severity is derived from estimated impact, findings sorted" \
              || bad "severity/ranking incoherent" "${sev//|/$'\n        '}"

# ---------------------------------------------------------------------------
head_ "3. SAFETY  (degrade, never crash; fixes reversible)"
# ---------------------------------------------------------------------------
mkdir -p "$TMP/junk/proj"
printf 'not json at all\n{"type":"assistant"\n{}\n' > "$TMP/junk/proj/broken.jsonl"
if "$TS" audit --root "$TMP/junk" >/dev/null 2>"$TMP/junk.err"; then
  bad "malformed transcript should exit non-zero (nothing to report)"
else
  if grep -qi traceback "$TMP/junk.err"; then
    bad "malformed transcript produced a traceback" "$(head -3 "$TMP/junk.err")"
  else
    ok "malformed transcript degrades with a message, no traceback"
  fi
fi

mkdir -p "$TMP/empty"
"$TS" audit --root "$TMP/empty" >/dev/null 2>"$TMP/empty.err"
grep -qi traceback "$TMP/empty.err" \
  && bad "empty transcript root produced a traceback" \
  || ok "empty transcript root reports cleanly"

# Fixes run against a throwaway CLAUDE_CONFIG_DIR so a verify run can never
# touch the operator's real configuration.
export CLAUDE_CONFIG_DIR="$TMP/home"
mkdir -p "$CLAUDE_CONFIG_DIR"
for fid in terse-output tool-search; do
  "$TS" fixes apply "$fid" --yes >/dev/null 2>&1
  a=$("$TS" fixes show "$fid" 2>/dev/null | grep -c "applied" || true)
  "$TS" fixes apply "$fid" --yes >"$TMP/second.$fid" 2>&1
  "$TS" fixes revert "$fid" >/dev/null 2>&1
  state=$("$TS" fixes show "$fid" 2>/dev/null | grep -c "not applied" || true)
  if [[ $a -ge 1 && $state -ge 1 ]] && grep -qi "no change" "$TMP/second.$fid"; then
    ok "fix $fid: applies, is idempotent, reverts"
  else
    bad "fix $fid: apply/idempotent/revert cycle broken" "$(cat "$TMP/second.$fid")"
  fi
done

# A corrupt settings.json must be refused, not overwritten. This is the one
# failure mode that would destroy user configuration.
printf '{ this is not json' > "$CLAUDE_CONFIG_DIR/settings.json"
before=$(cat "$CLAUDE_CONFIG_DIR/settings.json")
"$TS" fixes apply tool-search --yes >/dev/null 2>&1
after=$(cat "$CLAUDE_CONFIG_DIR/settings.json")
[[ $before == "$after" ]] \
  && ok "unparseable settings.json is refused, not overwritten" \
  || bad "unparseable settings.json was overwritten"

# ---------------------------------------------------------------------------
head_ "4. VERSIONS  (three places that must agree)"
# ---------------------------------------------------------------------------
# The CLI, the plugin manifest and the git tag are read by different consumers
# and drift silently. A v0.2.0 tag once pointed at a manifest saying 0.1.0.
vres=$(python3 - "$ROOT" <<'VERCHK'
import json, os, re, subprocess, sys
root = sys.argv[1]
bad = []
manifest = json.load(open(os.path.join(root, ".claude-plugin", "plugin.json")))["version"]
cli = re.search(r'TS_VERSION="([^"]+)"', open(os.path.join(root, "scripts", "ts")).read()).group(1)
if manifest != cli:
    bad.append("plugin.json %s != scripts/ts %s" % (manifest, cli))
# Only compare against a tag when the tree is clean. Mid-release the
# manifest is already bumped while HEAD still carries the PREVIOUS tag,
# and a check that fails during the normal release flow is a check people
# learn to ignore.
dirty = subprocess.run(["git", "-C", root, "status", "--porcelain"],
                       capture_output=True, text=True).stdout.strip()
if not dirty:
    tag = subprocess.run(["git", "-C", root, "tag", "--points-at", "HEAD"],
                         capture_output=True, text=True).stdout.split()
    tags = [t.lstrip("v") for t in tag if t.startswith("v")]
    if tags and manifest not in tags:
        bad.append("tag(s) %s at HEAD but plugin.json says %s"
                   % (",".join(tags), manifest))
print("|".join(bad))
VERCHK
)
if [[ -z $vres ]]; then
  ok "version agrees across plugin.json, scripts/ts and any tag at HEAD"
else
  bad "version drift" "${vres//|/$'\n        '}"
fi

# ---------------------------------------------------------------------------
head_ "5. REDACTION  (ts share must leak nothing)"
# ---------------------------------------------------------------------------
# A profile is meant to be sent to a stranger, so this plants identifying
# strings everywhere a transcript can carry them and asserts none survive.
# Spot-checking one machine's output proves nothing; a planted canary does.
leakdir="$TMP/leak/proj-CANARYPROJECT"
mkdir -p "$leakdir"
python3 - "$leakdir/CANARYSESSION.jsonl" <<'MKLEAK'
import json, sys
C = "CANARY7f3a"   # must not appear anywhere in the shared profile
u = {"input_tokens": 0, "cache_creation_input_tokens": 5000,
     "cache_read_input_tokens": 10000, "output_tokens": 50}
recs = []
for i in range(8):
    recs.append({"type": "assistant", "message": {"role": "assistant", "usage": u,
        "content": [{"type": "tool_use", "id": "t%d" % i, "name": "Bash",
                     "input": {"command": "cat /home/%s/secret_%s.txt" % (C, C)}}]}})
    recs.append({"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": "t%d" % i,
         "content": "contents of %s and more %s" % (C, C)}]}})
    recs.append({"type": "assistant", "message": {"role": "assistant", "usage": u,
        "content": [{"type": "tool_use", "id": "r%d" % i, "name": "Read",
                     "input": {"file_path": "/home/%s/%s.py" % (C, C)}}]}})
    recs.append({"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": "r%d" % i, "content": C * 200}]}})
    recs.append({"type": "assistant", "message": {"role": "assistant", "usage": u,
        "content": [{"type": "tool_use", "id": "m%d" % i,
                     "name": "mcp__%s__dothing" % C, "input": {"q": C}}]}})
    recs.append({"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": "m%d" % i, "content": C}]}})
with open(sys.argv[1], "w") as fh:
    for r in recs:
        fh.write(json.dumps(r) + "\n")
MKLEAK

if timeout 90 "$TS" share --root "$TMP/leak" --show >"$TMP/share.json" 2>"$TMP/share.err"; then
  hits=$(grep -o "CANARY7f3a\|CANARYPROJECT\|CANARYSESSION" "$TMP/share.json" | sort -u | tr '\n' ' ')
  if [[ -z $hits ]]; then
    ok "ts share: planted paths, commands, results and MCP names all redacted"
  else
    bad "ts share LEAKED identifying data" "found: $hits"
  fi
  python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$TMP/share.json" 2>/dev/null \
    && ok "ts share: emits valid JSON" \
    || bad "ts share: output is not valid JSON"
else
  bad "ts share failed" "$(head -3 "$TMP/share.err")"
fi

# ---------------------------------------------------------------------------
head_ "6. LIVE SIGNAL  (ts now)"
# ---------------------------------------------------------------------------
# Hand-derived, like the rest. Note the context of a turn is read+write+input
# -- the whole prompt that request paid for -- not the read alone. The bulk
# fixture's last turn reads 230,000 and writes 20,000, so context is 250,000;
# its first five turns bottom out at 10,000+20,000 = 30,000, the preamble.
# Break-even is then 1.25*30000 / (0.10*(250000-30000)) = 1.7045 turns.
# (Getting this wrong the first time is exactly what this check is for.)
sess=$(ls "$TMP"/bulk/proj-bulk/*.jsonl | head -1)
if timeout 60 "$TS" now --session "$sess" --json >"$TMP/now.json" 2>/dev/null; then
  res=$(python3 - "$TMP/now.json" <<'NOWCHK'
import json, sys
d = json.load(open(sys.argv[1]))
bad = []
if d["turns"] != 12:      bad.append("turns %s != 12" % d["turns"])
if d["context"] != 250000: bad.append("context %s != 250000" % d["context"])
if d["floor"] != 30000:   bad.append("floor %s != 30000" % d["floor"])
want = (1.25 * 30000) / (0.10 * (250000 - 30000))
if abs(d["breakeven_turns"] - want) > 1e-6:
    bad.append("breakeven %.4f != %.4f" % (d["breakeven_turns"], want))
print("|".join(bad))
NOWCHK
)
  if [[ -z $res ]]; then
    ok "ts now: context, preamble and break-even match hand arithmetic"
  else
    bad "ts now: wrong arithmetic" "${res//|/$'\n        '}"
  fi
else
  bad "ts now --json failed or timed out"
fi

# A session still at its preamble has nothing to gain, and must say so rather
# than printing a number that nags someone to clear a fresh session.
fresh="$TMP/fresh/proj/fresh.jsonl"
mkdir -p "$(dirname "$fresh")"
python3 - "$fresh" <<'MKFRESH'
import json, sys
u = {"input_tokens": 0, "cache_creation_input_tokens": 0,
     "cache_read_input_tokens": 10000, "output_tokens": 10}
with open(sys.argv[1], "w") as fh:
    for _ in range(6):
        fh.write(json.dumps({"type": "assistant", "message": {
            "role": "assistant", "content": [], "usage": u}}) + "\n")
MKFRESH
be=$(timeout 60 "$TS" now --session "$fresh" --json 2>/dev/null \
     | python3 -c 'import json,sys;print(json.load(sys.stdin)["breakeven_turns"])')
if [[ $be == None ]]; then
  ok "ts now: a session at its preamble reports no gain from clearing"
else
  bad "ts now: expected null break-even at the preamble, got $be"
fi

# --statusline runs inside a prompt: it must never hang, never write to stderr
# and never exit non-zero, whatever it is handed. The first version of this
# command hung forever on an idle stdin pipe, which is why this loop exists.
for label in empty garbage missing; do
  case $label in
    empty)   payload="" ;;
    garbage) payload="not json {{{" ;;
    missing) payload='{"transcript_path":"/nonexistent/x.jsonl"}' ;;
  esac
  if printf '%s' "$payload" | timeout 20 "$TS" now --statusline >"$TMP/sl.out" 2>"$TMP/sl.err"; then
    if [[ -s "$TMP/sl.err" ]]; then
      bad "ts now --statusline ($label stdin) wrote to stderr" "$(head -2 "$TMP/sl.err")"
    else
      ok "ts now --statusline: $label stdin handled silently"
    fi
  else
    bad "ts now --statusline ($label stdin) hung or exited non-zero"
  fi
done

# ---------------------------------------------------------------------------
printf '\n%s\n' "$(printf '%.0s-' {1..70})"
printf '  %s%d passed%s   %s%d failed%s   %d skipped\n' \
  "$GREEN" "$PASS" "$OFF" \
  "$( ((FAIL)) && printf '%s' "$RED" )" "$FAIL" "$OFF" "$SKIP"
[[ $KEEP == 1 ]] && printf '  %sfixtures kept in %s%s\n' "$DIM" "$TMP" "$OFF"
printf '\n'
exit $(( FAIL > 0 ))
