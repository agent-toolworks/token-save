#!/usr/bin/env bash
# verify — prove the numbers and the routing, against fixtures with known answers.
#
# Three things are checked, in order of how badly a regression would hurt:
#
#   1. ARITHMETIC  billed and content totals match values derived by hand in
#                  fixtures/EXPECTATIONS.json. Nothing here was recorded from
#                  program output.
#   2. ROUTING     the two Bash detectors are mutually exclusive across two
#                  deliberately opposite fleets. This is the central claim of
#                  the tool; if it breaks, the tool is giving generic advice.
#   3. SAFETY      malformed input degrades instead of crashing, and every
#                  mechanical fix is idempotent and reversible.
#
# Usage: scripts/verify [--keep]
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
TS="$ROOT/scripts/ts"
FIX="$ROOT/fixtures"
KEEP=0
[[ ${1:-} == --keep ]] && KEEP=1

PASS=0; FAIL=0; SKIP=0
GREEN=$'\033[32m'; RED=$'\033[31m'; DIM=$'\033[2m'; YEL=$'\033[33m'; OFF=$'\033[0m'
[[ -t 1 ]] || { GREEN=; RED=; DIM=; YEL=; OFF=; }

ok()   { PASS=$((PASS+1)); printf '  %sPASS%s  %s\n' "$GREEN" "$OFF" "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  %sFAIL%s  %s\n' "$RED" "$OFF" "$1";
         [[ -n ${2:-} ]] && printf '        %s\n' "$2"; }
skip() { SKIP=$((SKIP+1)); printf '  %sSKIP%s  %s %s\n' "$YEL" "$OFF" "$1" "${DIM}${2:-}${OFF}"; }
head_() { printf '\n%s\n%s\n' "$1" "$(printf '%.0s-' {1..70})"; }

command -v python3 >/dev/null 2>&1 || { echo "verify: python3 required"; exit 2; }

# timeout(1) is GNU coreutils and is NOT on a stock macOS -- the checks below
# exist precisely to catch a hang, so dropping the bound is not an option.
# perl's alarm is present on every platform this runs on. (Caught by CI: the
# whole ts-now section failed on macos-latest while passing on a dev Mac that
# happened to have brew coreutils installed.)
bounded() {
  local secs=$1; shift
  if command -v timeout >/dev/null 2>&1; then
    timeout "$secs" "$@"
  elif command -v gtimeout >/dev/null 2>&1; then
    gtimeout "$secs" "$@"
  else
    perl -e 'my $s = shift; alarm $s; exec @ARGV or exit 127' "$secs" "$@"
  fi
}

TMP=$(mktemp -d)

# Every check runs against a throwaway CLAUDE_CONFIG_DIR, not only the fixes
# section where this used to be set. Two reasons it belongs at the top:
#
#   1. A verify run must never touch the operator's real configuration.
#   2. Detector output must not depend on the machine running the tests. It
#      did: the routing checks in section 2 ran before this line, so
#      mcp-schema fired there off whatever MCP servers the developer happened
#      to have configured, and a contributor with a different setup saw
#      different fixture results.
#
# Until CLAUDE_JSON derived from CLAUDE_CONFIG_DIR (it was pinned to the real
# home) even this would not have isolated the global-MCP path, which is the
# hole that made it unreachable from any sandboxed test.
export CLAUDE_CONFIG_DIR="$TMP/home"
mkdir -p "$CLAUDE_CONFIG_DIR"
cleanup() { [[ $KEEP == 1 ]] || rm -rf "$TMP"; }
trap cleanup EXIT

# Fixtures are generated, not committed as opaque blobs, so a reader can see
# exactly what produced the expected numbers.
"$FIX/build-fixtures" --out "$TMP" >/dev/null || { echo "verify: could not build fixtures"; exit 2; }

# ---------------------------------------------------------------------------
head_ "1. ARITHMETIC  (against hand-derived expectations)"
# ---------------------------------------------------------------------------
for fleet in chatter bulk split; do
  out="$TMP/$fleet.json"
  if ! "$TS" audit --root "$TMP/$fleet" --json >"$out" 2>"$TMP/$fleet.err"; then
    bad "$fleet: audit --json failed" "$(head -3 "$TMP/$fleet.err")"
    continue
  fi
  result=$(python3 - "$FIX/EXPECTATIONS.json" "$out" "$fleet" <<'PY'
import json, sys
exp = json.load(open(sys.argv[1]))[sys.argv[3]]
got = json.load(open(sys.argv[2]))
bad = []
if got["turns"] != exp["turns"]:
    bad.append("turns %s != %s" % (got["turns"], exp["turns"]))
for k, v in exp["billed"].items():
    if got["billed"].get(k) != v:
        bad.append("billed.%s %s != %s" % (k, got["billed"].get(k), v))
for k, v in exp.get("bash", {}).items():
    g = got["bash"].get(k)
    # Content sizes are tokenizer-dependent; allow 5% on those, exact on counts.
    if k in ("calls",):
        if g != v:
            bad.append("bash.%s %s != %s" % (k, g, v))
    elif v and abs(g - v) / v > 0.05:
        bad.append("bash.%s %s not within 5%% of %s" % (k, g, v))
print("|".join(bad))
PY
)
  if [[ -z $result ]]; then
    ok "$fleet: billed totals and Bash distribution match expectations"
  else
    bad "$fleet: expectation mismatch" "${result//|/$'\n        '}"
  fi
done

# The two halves of the per-message rule need different treatment, and getting
# either wrong is silent: summing inputs multiplies every billed figure, and
# taking the FIRST output truncates it to a streaming partial.
splitchk=$(python3 - "$TMP/split.json" <<'SPLIT'
import json, sys
d = json.load(open(sys.argv[1]))
b = d["billed"]
bad = []
if d["turns"] != 5:
    bad.append("turns %s != 5 (counted lines, not messages)" % d["turns"])
if b["cache_read"] != 50000:
    bad.append("cache_read %s != 50000 (inputs summed across lines)" % b["cache_read"])
if b["output"] == 1510:
    bad.append("output summed the streaming partials")
elif b["output"] == 5:
    bad.append("output took the first line, truncating to a partial")
elif b["output"] != 1500:
    bad.append("output %s != 1500" % b["output"])
print("|".join(bad))
SPLIT
)
[[ -z $splitchk ]] && ok "usage counted once per message: inputs once, output max" \
                   || bad "per-message usage rule broken" "${splitchk//|/$'\n        '}"

# Amplification is the headline metric, so it gets its own check rather than
# riding along inside a bundle where a wrong value could hide.
amp=$("$TS" audit --root "$TMP/chatter" --json | python3 -c 'import json,sys;print(json.load(sys.stdin)["amplification"])')
exp_amp=$(python3 -c 'print(round(25020000/51540,1))' 2>/dev/null)
if python3 -c "import sys;sys.exit(0 if abs($amp-$exp_amp)/$exp_amp < 0.06 else 1)"; then
  ok "chatter: amplification ${amp}x matches 25,020,000 reads / content"
else
  bad "chatter: amplification ${amp}x, expected ~${exp_amp}x"
fi

# ---------------------------------------------------------------------------
head_ "2. ROUTING  (the same catalogue must give opposite advice)"
# ---------------------------------------------------------------------------
for fleet in chatter bulk; do
  adv="$TMP/$fleet.advise.json"
  if ! "$TS" advise --root "$TMP/$fleet" --json >"$adv" 2>/dev/null; then
    bad "$fleet: advise --json failed"
    continue
  fi
  result=$(python3 - "$FIX/EXPECTATIONS.json" "$adv" "$fleet" <<'PY'
import json, sys
exp = json.load(open(sys.argv[1]))[sys.argv[3]]
got = json.load(open(sys.argv[2]))
fired = {f["id"] for f in got["findings"]}
bad = []
for want in exp["fires"]:
    if want not in fired:
        bad.append("expected %s to fire" % want)
for quiet in exp["silent"]:
    if quiet in fired:
        bad.append("expected %s to stay silent" % quiet)
print("|".join(bad))
PY
)
  if [[ -z $result ]]; then
    ok "$fleet: fires ${DIM}$(python3 -c "import json;print(','.join(sorted(x['id'] for x in json.load(open('$adv'))['findings'])))")${OFF}"
  else
    bad "$fleet: wrong routing" "${result//|/$'\n        '}"
  fi
done

# The claim is not just "each fires somewhere" but "they never fire together".
both=$(python3 - "$TMP/chatter.advise.json" "$TMP/bulk.advise.json" <<'PY'
import json, sys
for p in sys.argv[1:]:
    ids = {f["id"] for f in json.load(open(p))["findings"]}
    if {"bash-chatter", "bash-bulk"} <= ids:
        print("both fired in %s" % p)
PY
)
[[ -z $both ]] && ok "bash-chatter and bash-bulk are mutually exclusive" \
                || bad "the two Bash detectors overlap" "$both"

# A projection with an unstated assumption is the exact failure this tool was
# built to catch someone else committing, so it may not exist in this tool.
asm=$(python3 - "$TMP/chatter.advise.json" "$TMP/bulk.advise.json" <<'ASM'
import json, sys
bad = []
for path in sys.argv[1:]:
    for f in json.load(open(path))["findings"]:
        c = f.get("confidence")
        if c == "measured":
            bad.append("%s: a saving may not be labelled 'measured'" % f["id"])
        if c != "derived" and not f.get("assumption"):
            bad.append("%s: %s saving with no stated assumption" % (f["id"], c))
print("|".join(sorted(set(bad))))
ASM
)
if [[ -z $asm ]]; then
  ok "every non-derived saving states what it assumed"
else
  bad "unstated assumptions" "${asm//|/$'\n        '}"
fi

# Severity must agree with the number it is derived from.
sev=$(python3 - "$TMP/chatter.advise.json" <<'PY'
import json, sys
bad = []
prev = None
for f in json.load(open(sys.argv[1]))["findings"]:
    if prev is not None and f["saving_pct"] > prev + 1e-9:
        bad.append("findings not sorted by saving_pct")
    prev = f["saving_pct"]
    want = "high" if f["saving_pct"] >= 8 else "medium" if f["saving_pct"] >= 2.5 else "low"
    if f["severity"] != want:
        bad.append("%s: severity %s but %.1f%% implies %s"
                   % (f["id"], f["severity"], f["saving_pct"], want))
print("|".join(bad))
PY
)
[[ -z $sev ]] && ok "severity is derived from estimated impact, findings sorted" \
              || bad "severity/ranking incoherent" "${sev//|/$'\n        '}"

# ---------------------------------------------------------------------------
head_ "3. SAFETY  (degrade, never crash; fixes reversible)"
# ---------------------------------------------------------------------------
mkdir -p "$TMP/junk/proj"
printf 'not json at all\n{"type":"assistant"\n{}\n' > "$TMP/junk/proj/broken.jsonl"
if "$TS" audit --root "$TMP/junk" >/dev/null 2>"$TMP/junk.err"; then
  bad "malformed transcript should exit non-zero (nothing to report)"
else
  if grep -qi traceback "$TMP/junk.err"; then
    bad "malformed transcript produced a traceback" "$(head -3 "$TMP/junk.err")"
  else
    ok "malformed transcript degrades with a message, no traceback"
  fi
fi

mkdir -p "$TMP/empty"
"$TS" audit --root "$TMP/empty" >/dev/null 2>"$TMP/empty.err"
grep -qi traceback "$TMP/empty.err" \
  && bad "empty transcript root produced a traceback" \
  || ok "empty transcript root reports cleanly"

for fid in terse-output tool-search; do
  "$TS" fixes apply "$fid" --yes >/dev/null 2>&1
  a=$("$TS" fixes show "$fid" 2>/dev/null | grep -c "applied" || true)
  "$TS" fixes apply "$fid" --yes >"$TMP/second.$fid" 2>&1
  "$TS" fixes revert "$fid" >/dev/null 2>&1
  state=$("$TS" fixes show "$fid" 2>/dev/null | grep -c "not applied" || true)
  if [[ $a -ge 1 && $state -ge 1 ]] && grep -qi "no change" "$TMP/second.$fid"; then
    ok "fix $fid: applies, is idempotent, reverts"
  else
    bad "fix $fid: apply/idempotent/revert cycle broken" "$(cat "$TMP/second.$fid")"
  fi
done

# A one-key change must produce a one-key diff. The writer used to round-trip
# settings.json through json.dump(), whose ensure_ascii escaped every em-dash
# and whose indent= re-indented every line, so adding one key rewrote lines
# nobody had touched. Both halves are pinned: unrelated prose, and the file's
# own indent width.
FCFG="$TMP/fmt"; mkdir -p "$FCFG"
cat > "$FCFG/settings.json" <<'JSON'
{
    "permissions": {
        "allow": ["Bash(ls:*)"]
    },
    "note": "policy — written in sentences — with typographic punctuation"
}
JSON
cp "$FCFG/settings.json" "$FCFG/orig"
CLAUDE_CONFIG_DIR="$FCFG" "$TS" fixes apply tool-search --yes >/dev/null 2>&1
churn=$(diff "$FCFG/orig" "$FCFG/settings.json" | grep -c '^[<>]' || true)
if grep -q '—' "$FCFG/settings.json" \
   && grep -q '^        "allow"' "$FCFG/settings.json" \
   && [[ $churn -le 5 ]]; then
  ok "tool-search edits in place: em-dashes and indent width survive"
else
  bad "tool-search rewrote unrelated lines ($churn lines changed)" \
      "$(diff "$FCFG/orig" "$FCFG/settings.json" | head -8)"
fi

# apply then revert must be a no-op on the bytes. The trailing newline is the
# classic casualty -- revert used to rstrip() the file and re-add one, so a
# file that never ended in a newline came back with one.
for variant in trailing no-trailing; do
  RCFG="$TMP/rt-$variant"; mkdir -p "$RCFG"
  if [[ $variant == trailing ]]; then
    printf '# Notes\n\n\ntext\n' > "$RCFG/CLAUDE.md"
  else
    printf '# Notes\n\n\ntext' > "$RCFG/CLAUDE.md"
  fi
  printf '{\n  "model": "opus"\n}\n' > "$RCFG/settings.json"
  cp "$RCFG/CLAUDE.md" "$RCFG/md.orig"
  cp "$RCFG/settings.json" "$RCFG/js.orig"
  for fid in terse-output tool-search; do
    CLAUDE_CONFIG_DIR="$RCFG" "$TS" fixes apply "$fid" --yes >/dev/null 2>&1
    CLAUDE_CONFIG_DIR="$RCFG" "$TS" fixes revert "$fid" >/dev/null 2>&1
  done
  if cmp -s "$RCFG/md.orig" "$RCFG/CLAUDE.md" \
     && cmp -s "$RCFG/js.orig" "$RCFG/settings.json"; then
    ok "apply+revert is byte-identical ($variant newline)"
  else
    bad "apply+revert altered the file ($variant newline)" \
        "$(diff "$RCFG/md.orig" "$RCFG/CLAUDE.md"; \
           diff "$RCFG/js.orig" "$RCFG/settings.json")"
  fi
done

# CLAUDE_JSON was the one path pinned to the real home while every other
# derived from CLAUDE_HOME, so global MCP config was read from the invoking
# user's actual home whatever CLAUDE_CONFIG_DIR said -- and no sandboxed test
# could reach that branch at all. Both directions are pinned: a canary planted
# in a sandboxed .claude.json must be READ (the path is reachable now), and the
# unset case must still resolve to ~/.claude.json, which is a SIBLING of
# ~/.claude rather than inside it, so it cannot simply be derived.
cfgj=$(python3 - "$ROOT" "$TMP" <<'CFGJ'
import json, os, subprocess, sys

root, tmp = sys.argv[1], sys.argv[2]
lib = os.path.join(root, "scripts", "lib")
code = ("import sys, json; sys.path.insert(0, %r); import machine; "
        "print(json.dumps({'home': machine.CLAUDE_HOME, "
        "'json': machine.CLAUDE_JSON, "
        "'servers': sorted((machine.mcp_servers() or {}).get('global') or []), "
        "'readable': machine.mcp_servers().get('readable')}))" % lib)


def probe(config_dir):
    env = dict(os.environ)
    env.pop("CLAUDE_CONFIG_DIR", None)
    if config_dir:
        env["CLAUDE_CONFIG_DIR"] = config_dir
    r = subprocess.run([sys.executable, "-c", code], capture_output=True,
                       text=True, env=env)
    if r.returncode != 0:
        raise SystemExit("probe failed: " + (r.stderr or "")[:200])
    return json.loads(r.stdout)


bad = []
sand = os.path.join(tmp, "cfgjson")
os.makedirs(sand, exist_ok=True)
with open(os.path.join(sand, ".claude.json"), "w") as fh:
    json.dump({"mcpServers": {"zqcanary-sandboxed": {}}}, fh)

got = probe(sand)
if got["json"] != os.path.join(sand, ".claude.json"):
    bad.append("CLAUDE_JSON is %r, expected it inside CLAUDE_CONFIG_DIR"
               % got["json"])
if got["servers"] != ["zqcanary-sandboxed"]:
    bad.append("sandboxed .claude.json was not read: servers=%r -- the global "
               "MCP path is still unreachable from a test" % got["servers"])

plain = probe(None)
if plain["json"] != os.path.expanduser("~/.claude.json"):
    bad.append("with CLAUDE_CONFIG_DIR unset, CLAUDE_JSON is %r, expected "
               "~/.claude.json" % plain["json"])
if plain["home"] != os.path.expanduser("~/.claude"):
    bad.append("with CLAUDE_CONFIG_DIR unset, CLAUDE_HOME moved to %r"
               % plain["home"])
if "zqcanary-sandboxed" in plain["servers"]:
    bad.append("the sandbox canary leaked into the unset case")
print("|".join(bad) if bad else "CLEAR")
CFGJ
)
[[ $cfgj == CLEAR ]] && ok "CLAUDE_JSON follows CLAUDE_CONFIG_DIR, and a sandboxed canary is read" \
                     || bad "CLAUDE_JSON does not respect the config dir" \
                            "${cfgj//|/$'\n        '}"

# doctor reported the on-disk size of every SKILL.md -- 27x what loads, and
# 7.6x the preamble it sat under -- with a caveat asking the reader to discount
# it. Only the frontmatter description loads. The same recursive walk also
# counted nested plugin copies of one skill as several skills, which inflated
# `skills_installed` in `ts share`, a field used to argue that machines differ.
skl=$(python3 - "$ROOT" "$TMP" <<'SKL'
import os, subprocess, sys, json

root, tmp = sys.argv[1], sys.argv[2]
home = os.path.join(tmp, "skillhome")


def skill(relpath, desc, body_kb):
    p = os.path.join(home, relpath, "SKILL.md")
    os.makedirs(os.path.dirname(p), exist_ok=True)
    with open(p, "w") as fh:
        fh.write("---\nname: %s\ndescription: %s\n---\n\n%s\n"
                 % (os.path.basename(relpath), desc, "body text " * (body_kb * 100)))


# `alpha` twice: the canonical shallow copy and a nested plugin copy.
skill("skills/alpha", "trigger phrase for alpha", 40)
skill("plugins/p1/skills/alpha", "trigger phrase for alpha", 40)
skill("plugins/p1/plugins/p2/skills/beta", "trigger phrase for beta", 40)

code = ("import sys, json; sys.path.insert(0, %r); import machine; "
        "print(json.dumps(machine.skills_footprint()))"
        % os.path.join(root, "scripts", "lib"))
env = dict(os.environ)
env["CLAUDE_CONFIG_DIR"] = home
r = subprocess.run([sys.executable, "-c", code], capture_output=True,
                   text=True, env=env)
if r.returncode != 0:
    raise SystemExit("probe failed: " + (r.stderr or "")[:200])
sk = json.loads(r.stdout)

bad = []
if sk["count"] != 2:
    bad.append("counted %d skills, expected 2 distinct (alpha, beta) from 3 "
               "SKILL.md files" % sk["count"])
if sk.get("duplicates") != 1:
    bad.append("reported %r duplicate copies, expected 1"
               % sk.get("duplicates"))
paths = [p for p, _t in sk["files"]]
if any(os.sep + "plugins" + os.sep in p and "alpha" in p for p in paths):
    bad.append("kept the nested copy of alpha instead of the shallowest path")
# The bodies are ~40KB each; the descriptions are a few words. If the body were
# being counted this would be thousands of tokens, which is the original bug.
if sk["desc_total"] > 60:
    bad.append("desc_total is %d tokens -- the body is being counted, not just "
               "the frontmatter description" % sk["desc_total"])
if sk["total"] <= sk["desc_total"] * 10:
    bad.append("on-disk total (%d) is not far above desc_total (%d); the "
               "fixture is not exercising the gap" % (sk["total"], sk["desc_total"]))
print("|".join(bad) if bad else "CLEAR")
SKL
)
[[ $skl == CLEAR ]] && ok "skills: deduplicated by name, and sized by description not by file" \
                    || bad "skills footprint wrong" "${skl//|/$'\n        '}"

# Real transcripts contain well-formed JSON of shapes nobody would write into
# a fixture. A `Read` whose `offset` is a LIST -- two records in 5,248 -- made
# the read key unhashable and took down four of five commands across a
# thousand-transcript corpus, with no partial result and no diagnostic, while
# this suite reported 52 passed. Fixtures contain the types their author
# expected; that is the third time that gap has shipped a bug here.
#
# Two properties, and they are different: a type confusion the code KNOWS about
# must be handled (counted, not skipped), and one it does not must be survived
# (skipped and reported, not fatal).
hostile=$(python3 - "$TMP" "$ROOT" <<'HOSTILE'
import json, os, sys
sys.path.insert(0, os.path.join(sys.argv[2], "scripts", "lib"))
from transcripts import Fleet

root = os.path.join(sys.argv[1], "hostile")
proj = os.path.join(root, "proj")
os.makedirs(proj, exist_ok=True)
U = {"input_tokens": 0, "cache_creation_input_tokens": 0,
     "cache_read_input_tokens": 9000, "output_tokens": 50}


def call(tid, name, inp):
    return {"type": "assistant", "message": {
        "role": "assistant",
        "content": [{"type": "tool_use", "id": tid, "name": name,
                     "input": inp}], "usage": U}}


def result(tid, content):
    return {"type": "user", "message": {
        "role": "user",
        "content": [{"type": "tool_result", "tool_use_id": tid,
                     "content": content}]}}


recs = [
    # A normal read, so there is something to get right.
    call("t1", "Read", {"file_path": "/a.py", "offset": 1, "limit": 50}),
    result("t1", "text " * 200),
    # The reported shape: offset is a list. Must be ACCOUNTED FOR, not skipped.
    call("t2", "Read", {"file_path": "/a.py", "offset": [389, 415], "limit": 50}),
    result("t2", "text " * 200),
    call("t3", "Read", {"file_path": "/a.py", "offset": [430, 435], "limit": None}),
    result("t3", "text " * 200),
    # Shapes nobody has reported yet. These may be skipped, but must not be
    # fatal -- that is the whole point of the guard.
    call("t4", "Read", ["not", "a", "dict"]),
    result("t4", "text " * 200),
    call("t5", "Bash", {"command": {"nested": "dict where a string belongs"}}),
    result("t5", {"weird": ["shape", 1, None]}),
    {"type": "assistant", "message": {"role": "assistant",
                                      "content": "a string, not a list",
                                      "usage": U}},
]
with open(os.path.join(proj, "s.jsonl"), "w") as fh:
    for r in recs:
        fh.write(json.dumps(r) + "\n")

bad = []
try:
    f = Fleet.load(root=root)
except Exception as exc:
    print("a hostile transcript raised %s: %s" % (type(exc).__name__, exc))
    raise SystemExit(0)

if not f.turns():
    bad.append("nothing was accounted for; the guard swallowed the whole file")
reads = {}
for sess in f.sessions:
    reads.update(sess.reads)
# The three reads differ only by range, and all three must be present and
# distinct -- a list offset is a DIFFERENT range, not an unusable record.
if len(reads) != 3:
    bad.append("expected 3 distinct read keys (1, [389,415], [430,435]), got "
               "%d: %r" % (len(reads), sorted(reads)))
if any(not isinstance(k, tuple) or any(not isinstance(x, str) for x in k)
       for k in reads):
    bad.append("read keys are not fully coerced to strings: %r" % sorted(reads))
if f.skipped() < 1:
    bad.append("no record was reported skipped, though the file contains "
               "shapes the accounting cannot use")
print("|".join(bad) if bad else "CLEAR skipped=%d reads=%d" % (f.skipped(), len(reads)))
HOSTILE
)
if [[ $hostile == CLEAR* ]]; then
  ok "a hostile transcript degrades: known types handled, unknown ones skipped ${DIM}(${hostile#CLEAR })${OFF}"
else
  bad "hostile transcript not survived" "${hostile//|/$'\n        '}"
fi

# And end to end: the commands must still RUN. The regression was not a wrong
# number, it was four of five commands exiting 1 on a corpus that was 99.96%
# fine, so the check is that they complete.
# `doctor` reads the present rather than a corpus and takes no --root, so it
# is pointed at the hostile tree through TS_TRANSCRIPT_DIR, which is what
# transcript_dir() honours. It was one of the four commands that died.
ran=""
for cmd in audit advise doctor share; do
  TS_TRANSCRIPT_DIR="$TMP/hostile" bounded 60 "$TS" "$cmd" \
      >/dev/null 2>"$TMP/hostile.$cmd.err" || ran="$ran $cmd(exit)"
  grep -qi traceback "$TMP/hostile.$cmd.err" && ran="$ran $cmd(traceback)"
done
[[ -z $ran ]] && ok "audit, advise, doctor and share all complete on a hostile corpus" \
              || bad "commands still die on a hostile transcript" \
                     "${ran# }$(printf '\n        '; head -3 "$TMP/hostile.${ran%%(*}.err" 2>/dev/null)"

# A corrupt settings.json must be refused, not overwritten. This is the one
# failure mode that would destroy user configuration.
printf '{ this is not json' > "$CLAUDE_CONFIG_DIR/settings.json"
before=$(cat "$CLAUDE_CONFIG_DIR/settings.json")
"$TS" fixes apply tool-search --yes >/dev/null 2>&1
after=$(cat "$CLAUDE_CONFIG_DIR/settings.json")
[[ $before == "$after" ]] \
  && ok "unparseable settings.json is refused, not overwritten" \
  || bad "unparseable settings.json was overwritten"

# The estimator's divisor is per content class. 3.6 was accurate in AGGREGATE
# while describing no actual class: measured against tiktoken over 14.3M chars
# of real transcript, the classes run 2.48 (dense JSON) to 4.72 (prose). That
# put up to 31% error on a single bucket while the total looked fine, and it
# landed on the denominator of amplification. Pinned here: the no-class default
# is UNCHANGED (toks() has callers outside parse()), the per-class divisors are
# the ones that were measured, and no bucket silently loses its constant.
est=$(python3 - "$ROOT" <<'EST'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "scripts", "lib"))
import transcripts as T

bad = []
if T._ENC is not None:
    print("SKIP tiktoken is installed, so toks() is exact and has no divisor")
    raise SystemExit(0)

# No class = the old single constant, exactly. This is the compatibility the
# change rests on: fixtures and any caller outside parse() must not shift.
if T.toks("x" * 3600) != 1000:
    bad.append("no-class toks() no longer divides by 3.6 (got %d, want 1000)"
               % T.toks("x" * 3600))

for cls, want in ((T.BUCKET_ASSISTANT, 4.06), (T.BUCKET_USER, 4.49),
                  (T.BUCKET_TOOL_IN, 3.50), (T.BUCKET_TOOL_TEXT, 3.53),
                  (T.CPT_BASH, 3.69), (T.BUCKET_ATTACH, 3.68),
                  (T.BUCKET_SYSTEM, 2.48)):
    n = 10000
    got = T.toks("x" * n, cls)
    if got != int(n / want):
        bad.append("%s divides by %.3f, expected %.2f"
                   % (cls, n / float(got or 1), want))

# A new bucket added without a constant would silently inherit 3.6 and its
# error would be invisible. Both lists are explicit so that shows up here.
have = set(T._CPT)
want_have = {T.BUCKET_ASSISTANT, T.BUCKET_USER, T.BUCKET_TOOL_IN,
             T.BUCKET_TOOL_TEXT, T.CPT_BASH, T.BUCKET_ATTACH, T.BUCKET_SYSTEM}
if have != want_have:
    bad.append("calibrated classes changed: +%s -%s"
               % (sorted(have - want_have), sorted(want_have - have)))
# thinking is deliberately uncalibrated: Claude Code stores the field empty.
if T.BUCKET_THINKING in T._CPT:
    bad.append("thinking has a divisor, but the field is always empty")

# Bash and non-Bash tool results must stay separable even though the report
# pools them -- that gap is the largest single contributor to the spread.
if T._CPT[T.CPT_BASH] == T._CPT[T.BUCKET_TOOL_TEXT]:
    bad.append("Bash and non-Bash tool results collapsed to one divisor")
print("|".join(bad) if bad else "CLEAR")
EST
)
case "$est" in
  CLEAR)  ok "estimator: per-class divisors, and no-class behaviour unchanged" ;;
  SKIP*)  skip "estimator per-class divisors" "${est#SKIP }" ;;
  *)      bad "estimator calibration wrong" "${est//|/$'\n        '}" ;;
esac

# ---------------------------------------------------------------------------
head_ "4. COMMAND CLASSIFIER  (the BASH DETAIL leaderboard)"
# ---------------------------------------------------------------------------
# A leading-token regex reported `SP` as a program for `SP=/path cmd`. On the
# machine that reported it, 42.4% of Bash calls were attributed to a variable.
# The obvious fix leaks the other way (a redirect digit, a `for` keyword), so
# both directions are pinned here.
prog=$(python3 - "$ROOT" <<'PROG'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "scripts", "lib"))
from transcripts import command_program as cp
cases = [
    ("SP=/a/b grep x", "grep"),                      # assignment prefix
    ("A=1 B=2 C=3 sed -n 1,5p f", "sed"),            # several of them
    ("R=~/r && cd $R && git status", "git"),         # assignment then cd chain
    ("cd /x && npm run build", "npm"),
    ("cd '/x y' && pytest -q", "pytest"),            # quoted path with a space
    ("cd a; cd b; ls", "ls"),                        # semicolon chain
    ("env FOO=1 python3 t.py", "python3"),           # wrapper + assignment
    ("time make -j4", "make"),
    ("/usr/local/bin/node x.js", "node"),            # path stripped
    ("for i in 1 2; do echo $i; done", "for"),       # keyword IS the answer
    ("echo hi", "echo"),
    ("", "?"),
    # Newlines separate commands too -- this is what left `cd` and `export`
    # sitting at the top of a real leaderboard describing nothing.
    ("cd /x\necho hi\nrg foo", "echo"),
    ("cd /x\nSC=/y\npython3 $SC", "python3"),
    ("cd /only/here", "cd"),        # genuinely just a cd: say so
    ("export FOO=1", "export"),     # genuinely just an export
]
bad = ["%s -> %s (want %s)" % (repr(c), cp(c), w) for c, w in cases if cp(c) != w]
print("|".join(bad))
PROG
)
if [[ -z $prog ]]; then
  ok "command_program: assignments, wrappers, cd chains and keywords"
else
  bad "command_program misclassifies" "${prog//|/$'\n        '}"
fi

# The cd-shape discriminator decides whether bash-chatter tells you to batch
# `cd` ceremony away or that doing so would be a bad trade. Both branches are
# pinned, and so is the newline case that made every multi-line script look
# standalone (622 of 622 on the first machine tested).
cds=$(python3 - "$ROOT" <<'CDS'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "scripts", "lib"))
from transcripts import cd_shape
cases = [
    ("cd /x", "standalone"),
    ("cd /x && npm run build", "chained"),
    ("cd /x; ls", "chained"),
    ("cd /x\necho hi\nrg foo", "chained"),    # multi-line is NOT standalone
    ("cd /x\n", "standalone"),                # trailing newline only
    ("git -C /x status", None),               # the scoped form uses no cd
    ("echo hi", None),
    ("", None),
]
bad = ["%s -> %s (want %s)" % (repr(c), cd_shape(c), w)
       for c, w in cases if cd_shape(c) != w]
print("|".join(bad))
CDS
)
if [[ -z $cds ]]; then
  ok "cd_shape distinguishes standalone from chained, multi-line included"
else
  bad "cd_shape misclassifies" "${cds//|/$'\n        '}"
fi

# ---------------------------------------------------------------------------
head_ "5. DETECTOR COVERAGE  (every detector has something that fires it)"
# ---------------------------------------------------------------------------
# CONTRIBUTING asks a contributor to add a fixture that makes their detector
# fire. That is only fair if the existing ones are held to the same bar, so
# this fails when a detector in CATALOGUE has no profile covering it.
"$FIX/build-detector-fixtures" --out "$TMP" >/dev/null 2>&1 || true
declare -a FLEETS=(verbose reasoning attachments images rereads subagents hooks chatter bulk)
declare -a covered=()
for prof in verbose:output-verbosity reasoning:reasoning-cost attachments:attachments \
            images:images rereads:repeat-reads subagents:subagent-cost \
            hooks:hook-output; do
  name=${prof%%:*}; want=${prof##*:}
  got=$(bounded 60 "$TS" advise --root "$TMP/$name" --json 2>/dev/null \
        | python3 -c 'import json,sys;print(",".join(f["id"] for f in json.load(sys.stdin)["findings"]))' 2>/dev/null)
  if [[ ",$got," == *",$want,"* ]]; then
    ok "fixture '$name' fires $want"
    covered+=("$want")
  else
    bad "fixture '$name' did not fire $want" "fired: ${got:-nothing}"
  fi
done

# Discovery is asserted on its own. The bug was a one-level glob that skipped
# every nested subagent transcript, and no content fixture could reach it: a
# detector firing is an indirect way to learn that a file was opened.
disc=$(python3 - "$TMP/subagents" "$ROOT" <<'DISC'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[2], "scripts", "lib"))
from transcripts import find_transcripts, is_subagent_path
root = sys.argv[1]
found = find_transcripts(root)
nested = [p for p in found if is_subagent_path(p, root)]
bad = []
if len(found) != 3:
    bad.append("found %d transcripts, expected 3" % len(found))
if len(nested) != 2:
    bad.append("classified %d as subagent, expected 2" % len(nested))
# Both real-world layouts must be reached. Compare RELATIVE to root: the
# fixture directory is itself called "subagents", so an absolute-path
# substring test matches every file and silently passes half of this.
rels = [os.path.relpath(p, root) for p in nested]
if not any("subagents" in r.split(os.sep)[:-1] for r in rels):
    bad.append("did not find the <session>/subagents/<agent> layout")
if not any("subagents" not in r.split(os.sep)[:-1] for r in rels):
    bad.append("did not find the <session>/<agent> layout")
print("|".join(bad))
DISC
)
if [[ -z $disc ]]; then
  ok "recursive discovery finds nested subagent transcripts (both layouts)"
else
  bad "subagent discovery broken" "${disc//|/$'\n        '}"
fi

# --limit is documented as the N most recent SESSIONS. Recursive discovery made
# "file" and "session" different things -- a subagent transcript is written the
# moment it runs, so it sorts to the top by mtime -- and the cut happened before
# classification. On the reporting machine --limit 25 was 11 sessions and 14
# subagent transcripts, and the run still called itself sessions=25. The tree
# below has every subagent NEWER than every main session, which is that shape.
lim=$(python3 - "$TMP/limit" "$ROOT" <<'LIM'
import json, os, sys, time
sys.path.insert(0, os.path.join(sys.argv[2], "scripts", "lib"))
from transcripts import Fleet

root = sys.argv[1]
proj = os.path.join(root, "proj")


def write(path, turns, when):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        for _ in range(turns):
            fh.write(json.dumps({"type": "assistant", "message": {
                "role": "assistant",
                "content": [{"type": "text", "text": "alpha beta gamma delta"}],
                "usage": {"input_tokens": 0, "cache_creation_input_tokens": 0,
                          "cache_read_input_tokens": 1000,
                          "output_tokens": 50}}}) + "\n")
    os.utime(path, (when, when))


now = time.time()
for n in range(4):                       # s0 oldest .. s3 newest
    write(os.path.join(proj, "s%d.jsonl" % n), 6, now - 400 + n * 100)
for sess, count in (("s3", 3), ("s2", 2), ("s0", 1)):
    for k in range(count):
        write(os.path.join(proj, sess, "subagents", "a%d.jsonl" % k), 4, now)

bad = []


def counts(**kw):
    f = Fleet.load(root=root, **kw)
    return ([s for s in f.sessions if not s.is_subagent],
            [s for s in f.sessions if s.is_subagent])

mains, subs = counts(limit=2)
ids = sorted(s.session_id for s in mains)
if ids != ["s2", "s3"]:
    bad.append("--limit 2 picked %s, expected the two newest ['s2', 's3']" % ids)
if len(subs) != 5:
    bad.append("--limit 2 kept %d subagents, expected the 5 belonging to s2/s3"
               % len(subs))
mains, subs = counts(limit=1)
if [s.session_id for s in mains] != ["s3"] or len(subs) != 3:
    bad.append("--limit 1 gave %s + %d subagents, expected ['s3'] + 3"
               % ([s.session_id for s in mains], len(subs)))
# s0's subagent must not ride along on a window that excludes s0.
if any(s.path.split(os.sep)[-3] == "s0" for s in subs):
    bad.append("a subagent of an excluded session was kept")
mains, subs = counts()
if len(mains) != 4 or len(subs) != 6:
    bad.append("unlimited load changed: %d sessions + %d subagents, expected 4 + 6"
               % (len(mains), len(subs)))
print("|".join(bad))
LIM
)
if [[ -z $lim ]]; then
  ok "--limit N selects N sessions and brings their subagents with them"
else
  bad "--limit still counts files, not sessions" "${lim//|/$'\n        '}"
fi

# A --json consumer could not tell the two populations apart, which is how the
# mislabel stayed invisible from the outside.
counted=$("$TS" audit --root "$TMP/limit" --limit 2 --json 2>/dev/null | python3 -c \
  'import json,sys; d=json.load(sys.stdin); print(d.get("sessions"), d.get("subagent_transcripts"))' 2>/dev/null)
[[ $counted == "2 5" ]] \
  && ok "audit --json splits sessions from subagent_transcripts" \
  || bad "audit --json session counts wrong" "got '$counted', expected '2 5'"
# A gate is a CLAIM about why a detector fired, and a claim in a comment drifts
# from the code under it. Here it is checked: anything that fired must declare
# a gate and must sit at or past it. A margin below 1 means the declared
# thresholds and the `if` disagree, and the reported "fires at N.Nx" is fiction.
#
# What this does NOT catch, said plainly rather than left to be assumed: a
# bound inflated to a value the fixture still clears. The detector fixtures are
# deliberately extreme -- the attachments fleet is 99% attachments against an
# 8% bound -- so raising that literal to 25% in the Cond alone still leaves a
# margin of 4x and passes here. Catching that needs a fixture sitting NEAR each
# threshold, which is a different fixture design than "smallest thing that
# trips it". Missing, crashed and violated gates are covered; drift within the
# fixture's headroom is not.
gates=$(python3 - "$TMP" "$ROOT" "${FLEETS[@]}" <<'GATE'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[2], "scripts", "lib"))
import advise, machine
from transcripts import Fleet

tmp, roots = sys.argv[1], sys.argv[3:]
mach = machine.collect()
bad = []
seen = 0
for name in roots:
    root = os.path.join(tmp, name)
    if not os.path.isdir(root):
        continue
    for f in advise.run(Fleet.load(root=root), mach):
        seen += 1
        if f.gate is None:
            bad.append("%s/%s: fired with no gate declared" % (name, f.id))
            continue
        m = f.gate.margin
        if m is None:
            if not any(c.mode == "flag" for c in f.gate.conditions):
                bad.append("%s/%s: gate has no measurable condition" % (name, f.id))
            continue
        if m < 0.999:
            bad.append("%s/%s: fired at %.3fx its own gate -- the declared "
                       "thresholds disagree with the code" % (name, f.id, m))
        # Only an ALL gate requires every condition to hold. An ANY gate is
        # cleared by one, and its others are legitimately below bound --
        # `preamble` fires on share alone while the machine's preamble sits
        # under the size threshold, which is the design, not a defect.
        if f.gate.mode == "all":
            for c in f.gate.conditions:
                if c.mode == "at_least" and c.bound and c.value < c.bound * 0.999:
                    bad.append("%s/%s: ALL gate condition %r is %s, below its "
                               "bound %s" % (name, f.id, c.name, c.value, c.bound))
                if c.mode == "at_most" and c.bound and c.value > c.bound * 1.001:
                    bad.append("%s/%s: ALL gate condition %r is %s, above its "
                               "bound %s" % (name, f.id, c.name, c.value, c.bound))
        elif f.gate.margin is not None and f.gate.margin < 0.999:
            bad.append("%s/%s: no condition of its ANY gate is satisfied"
                       % (name, f.id))
if not seen:
    bad.append("no findings were produced at all -- the check proved nothing")
# An all-clear must be SAID. An empty stdout is what a traceback looks like,
# and reading that as "no problems" is how a broken check passes forever.
print("|".join(bad) if bad else "CLEAR %d findings" % seen)
GATE
)
if [[ $gates == CLEAR* ]]; then
  ok "every fired finding declares a gate and sits at or past it ${DIM}(${gates#CLEAR })${OFF}"
else
  bad "a declared gate disagrees with its detector" \
      "${gates//|/$'\n        '}"
fi

# An ANY gate is cleared by its best condition, an ALL gate held up by its
# worst. Getting that backwards would report a margin the detector has not got,
# and would do it silently, so both directions are pinned on known values.
mg=$(python3 - "$ROOT" <<'MG'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "scripts", "lib"))
from advise import Cond, Gate
bad = []
lo = Cond("lo", 12.0, 10.0)                       # 1.2x
hi = Cond("hi", 30.0, 10.0)                       # 3.0x
if abs(Gate("any", [lo, hi]).margin - 3.0) > 1e-9:
    bad.append("ANY gate should take the condition it is furthest past (3.0x)")
if abs(Gate("all", [lo, hi]).margin - 1.2) > 1e-9:
    bad.append("ALL gate should take the condition it is closest to losing (1.2x)")
if Gate("any", [lo, hi]).binding is not hi or Gate("all", [lo, hi]).binding is not lo:
    bad.append("binding condition does not match the margin it produced")
inv = Cond("under a ceiling", 2500.0, 5000.0, mode="at_most")
if abs(inv.ratio - 2.0) > 1e-9:
    bad.append("an at_most condition at half its ceiling should read 2.0x")
flag = Cond("a boolean", True, None, mode="flag")
if flag.ratio is not None or Gate("any", [flag]).margin is not None:
    bad.append("a boolean condition must not invent a ratio")
print("|".join(bad) if bad else "CLEAR")
MG
)
[[ $mg == CLEAR ]] && ok "gate margin: ANY takes the max, ALL the min, flags abstain" \
                   || bad "margin arithmetic wrong" \
                          "${mg//|/$'\n        '}"

# The attachments bucket was one number covering four cost sources with four
# different fixes, so its advice could only ever be right for whichever source
# happened to dominate. Two things are pinned: the split reaches the families,
# and an unknown type is NOT guessed into one. Claude Code's type strings move
# between releases, and a closed vocabulary meeting a moving target is a bug
# this repo has already had more than once.
fam=$(python3 - "$TMP" "$ROOT" <<'FAM'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[2], "scripts", "lib"))
from transcripts import (FAM_BOOKKEEPING, FAM_FILE, FAM_HOOK, FAM_LISTING,
                         FAM_OTHER, Fleet, attach_family)

bad = []
for t, want in (("skill_listing", FAM_LISTING),
                ("deferred_tools_delta", FAM_LISTING),
                ("hook_success", FAM_HOOK),
                ("edited_text_file", FAM_FILE),
                ("total_tokens_reminder", FAM_BOOKKEEPING)):
    got = attach_family(t)
    if got != want:
        bad.append("%s classified as %r, expected %r" % (t, got, want))
# A type invented by a future release must surface, not be absorbed.
for t in ("some_future_delta", "skill_listing_v2", ""):
    if attach_family(t) != FAM_OTHER:
        bad.append("unknown type %r was absorbed into %r instead of %r"
                   % (t, attach_family(t), FAM_OTHER))

fams = Fleet.load(root=os.path.join(sys.argv[1], "attachments")).attach_families()
present = {k for k, v in fams.items() if v}
if len(present) < 3:
    bad.append("attachments fixture reached only %d families (%s); the split "
               "is not being exercised" % (len(present), sorted(present)))
if FAM_OTHER in present:
    bad.append("attachments fixture produced unrecognised types: the fixture "
               "and the family map disagree")
print("|".join(bad) if bad else "CLEAR")
FAM
)
[[ $fam == CLEAR ]] && ok "attachment families split, and unknown types stay unrecognised" \
                    || bad "attachment family classification wrong" \
                           "${fam//|/$'\n        '}"

# hook-output must be SILENT on a machine whose hooks do not chatter. This is
# the bash-chatter/bash-bulk discipline applied to a new detector: firing
# everywhere would make it decoration, and #5 exists because six detectors
# already do that.
quiet=$(python3 - "$TMP" "$ROOT" <<'QUIET'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[2], "scripts", "lib"))
import advise, machine
from transcripts import Fleet
tmp = sys.argv[1]
mach = machine.collect()
bad = []
fired = {f.id for f in advise.run(Fleet.load(root=os.path.join(tmp, "hooks")), mach)}
if "hook-output" not in fired:
    bad.append("hook-output did not fire on the hooks fleet")
for other in ("attachments", "verbose", "rereads", "images"):
    d = os.path.join(tmp, other)
    if not os.path.isdir(d):
        continue
    if "hook-output" in {f.id for f in advise.run(Fleet.load(root=d), mach)}:
        bad.append("hook-output fired on the %r fleet, which has no hook "
                   "records at all" % other)
print("|".join(bad) if bad else "CLEAR")
QUIET
)
[[ $quiet == CLEAR ]] && ok "hook-output fires on hook chatter and is silent without it" \
                      || bad "hook-output does not discriminate" \
                             "${quiet//|/$'\n        '}"

# `preamble` fires on the claim that the preamble is worth auditing, then had
# to say what is in it. On the reporting machine it itemised 11,206 of 62,294
# tokens and left 82% unnamed -- "audit these files" aimed at 18% of the
# subject. The rule pinned here is not that attribution is COMPLETE, which it
# cannot be, but that it is HONEST: the parts and the residual must account for
# the whole preamble, and the residual must be labelled rather than dropped, so
# a partial itemisation cannot be read as a complete one.
attr=$(python3 - "$TMP" "$ROOT" "${FLEETS[@]}" <<'ATTR'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[2], "scripts", "lib"))
import advise, machine
from transcripts import Fleet

tmp, roots = sys.argv[1], sys.argv[3:]
mach = machine.collect()
bad = []
seen = 0
for name in roots:
    root = os.path.join(tmp, name)
    if not os.path.isdir(root):
        continue
    for f in advise.run(Fleet.load(root=root), mach):
        if f.id != "preamble":
            continue
        seen += 1
        a = f.attribution
        if not a:
            bad.append("%s: preamble fired with no attribution" % name)
            continue
        total = sum(v for v, _l, _h in a["parts"]) + a["residual"]
        if total != a["total"]:
            bad.append("%s: parts + residual = %d, preamble is %d -- the "
                       "itemisation does not account for its own subject"
                       % (name, total, a["total"]))
        for v, label, how in a["parts"]:
            if v <= 0:
                bad.append("%s: part %r has %d tokens" % (name, label, v))
            if not how:
                bad.append("%s: part %r does not say where it came from"
                           % (name, label))
if not seen:
    bad.append("preamble did not fire on any fixture fleet -- proved nothing")
print("|".join(bad) if bad else "CLEAR %d" % seen)
ATTR
)
if [[ $attr == CLEAR* ]]; then
  ok "preamble attribution accounts for the whole preamble, residual named"
else
  bad "preamble attribution does not add up" "${attr//|/$'\n        '}"
fi

# The saving must be scoped to what could be named. The old figure took a third
# of the ENTIRE preamble, and on this machine 77% of it is system prompt and
# built-in tool schemas -- so it was projecting a trim of something the reader
# cannot edit.
scope=$(python3 - "$ROOT" <<'SCOPE'
import os, sys
sys.path.insert(0, os.path.join(sys.argv[1], "scripts", "lib"))
import advise
from advise import Finding

bad = []
# A preamble that is 20% attributable must not claim the saving of one that is
# fully attributable. Exercised through the real detector on a synthetic mach.
src = open(os.path.join(sys.argv[1], "scripts", "lib", "advise.py")).read()
if "attributed / float(med)" not in src:
    bad.append("saving is no longer scoped by the attributable fraction")
if "a third of the preamble is removable\"," in src:
    bad.append("the old flat one-third assumption is still the primary path")
print("|".join(bad) if bad else "CLEAR")
SCOPE
)
[[ $scope == CLEAR ]] && ok "preamble saving is scoped to the attributable part" \
                      || bad "preamble saving scope wrong" "${scope//|/$'\n        '}"

# session-length's fraction describes how much CONTEXT RE-READING shrinks, so
# it may only be applied to the cache-read component. It was applied to
# cost_units -- reads plus writes plus output -- and splitting a session
# reduces neither of the other two: the same work produces the same output
# across two sessions, and the split adds a preamble write. 1.44x over-stated
# on the reporting machine, 1.28x here.
#
# Checked by the property the bug breaks rather than by the arithmetic. Two
# fleets with IDENTICAL context shapes and different output volume: the tokens
# saved are the same, so the share of spend must FALL as output grows. Applied
# to cost_units it barely moves, because numerator and denominator grow
# together.
base=$(python3 - "$TMP" "$ROOT" <<'BASE'
import json, os, sys
sys.path.insert(0, os.path.join(sys.argv[2], "scripts", "lib"))
import advise, machine
from transcripts import Fleet

tmp = sys.argv[1]
mach = machine.collect()


def build(root, out_tokens):
    d = os.path.join(root, "proj")
    os.makedirs(d, exist_ok=True)
    for n in range(4):
        with open(os.path.join(d, "s%d.jsonl" % n), "w") as fh:
            ctx = 20000
            for _ in range(100):
                fh.write(json.dumps({"type": "assistant", "message": {
                    "role": "assistant",
                    "content": [{"type": "text", "text": "alpha beta gamma"}],
                    "usage": {"input_tokens": 0,
                              "cache_creation_input_tokens": 0,
                              "cache_read_input_tokens": ctx,
                              "output_tokens": out_tokens}}}) + "\n")
                ctx += 1800


def saving(out_tokens, tag):
    root = os.path.join(tmp, "base-%s" % tag)
    build(root, out_tokens)
    for f in advise.run(Fleet.load(root=root), mach):
        if f.id == "session-length":
            return f.saving_pct
    return None


lo = saving(10, "lo")       # almost no output: spend is nearly all reads
hi = saving(9000, "hi")     # output-heavy: same reads, much larger bill
bad = []
if lo is None or hi is None:
    bad.append("session-length did not fire on the synthetic fleets "
               "(lo=%r hi=%r)" % (lo, hi))
else:
    if hi >= lo:
        bad.append("saving did not fall when output grew (lo %.2f%%, hi %.2f%%)"
                   " -- the fraction is still being applied to total spend"
                   % (lo, hi))
    elif lo / hi < 1.5:
        bad.append("saving barely moved with output (lo %.2f%%, hi %.2f%%, "
                   "ratio %.2f) -- expected the output-heavy fleet to be much "
                   "lower" % (lo, hi, lo / hi))
print("|".join(bad) if bad else "CLEAR lo=%.1f%% hi=%.1f%%" % (lo, hi))
BASE
)
if [[ $base == CLEAR* ]]; then
  ok "session-length saving scales with cache reads, not total spend ${DIM}(${base#CLEAR })${OFF}"
else
  bad "session-length applies its fraction to the wrong base" \
      "${base//|/$'\n        '}"
fi

# The correction belongs in the shared helper, not hand-inlined: session-length
# was the one caller that bypassed to_spend(), which is the drift that helper's
# own docstring warns about. Every detector's saving must be 0, or routed
# through to_spend(), or built from the cost-weighted OUTPUT component -- which
# is a different component being reduced, and correct for that reason.
helper=$(python3 - "$ROOT" <<'HELP'
import os, re, sys
src = open(os.path.join(sys.argv[1], "scripts", "lib", "advise.py")).read()
bad = []


def resolves_ok(expr, depth=0):
    """Accept a saving that is zero, routed through to_spend(), or built from
    the cost-weighted OUTPUT component -- a different component being reduced,
    and correct for that reason.

    Detectors name an intermediate before returning it, so one level of
    indirection is followed: a bare `derived_pct` is judged by wherever
    `derived_pct` was assigned.
    """
    flat = " ".join(expr.split())
    if flat in ("0.0", "0"):
        return True
    if "to_spend(" in flat or "out_share" in flat or 'PRICE["output"]' in flat:
        return True
    if depth > 2:
        return False
    for name in set(re.findall(r"[A-Za-z_][A-Za-z0-9_]*", flat)):
        for a in re.finditer(r"^\s*%s\s*=\s*(.+)$" % re.escape(name), src, re.M):
            if resolves_ok(a.group(1), depth + 1):
                return True
    return False


for m in re.finditer(r"saving_pct=(.*?),\n", src, re.S):
    if not resolves_ok(m.group(1)):
        bad.append("a saving is computed as %r, which is neither to_spend() "
                   "nor the output component"
                   % " ".join(m.group(1).split())[:70])
print("|".join(bad) if bad else "CLEAR")
HELP
)
[[ $helper == CLEAR ]] && ok "every saving routes through to_spend() or the output component" \
                       || bad "a detector bypasses the shared conversion" \
                              "${helper//|/$'\n        '}"

# repeat-reads called its number "redundant copies" while counting two things
# that are not copies: reads at DIFFERENT byte ranges of one file, because
# offset/limit were dropped from the key, and reads in DIFFERENT sessions,
# because they were pooled fleet-wide. 89% of the groups it fired on here had
# every read at a distinct range. Both non-copy cases are asserted to produce
# exactly ZERO, which is the arithmetic most likely to regress.
rr=$(python3 - "$TMP" "$ROOT" <<'RR'
import json, os, sys
sys.path.insert(0, os.path.join(sys.argv[2], "scripts", "lib"))
from transcripts import Fleet

root = os.path.join(sys.argv[1], "rereads-exact")
proj = os.path.join(root, "proj")
os.makedirs(proj, exist_ok=True)
BODY = "alpha beta gamma delta epsilon " * 400      # ~2k tokens a read


def session(path, reads):
    recs, n = [], 0
    for fp, off, lim in reads:
        n += 1
        tid = "t%d" % n
        inp = {"file_path": fp}
        if off is not None:
            inp["offset"] = off
        if lim is not None:
            inp["limit"] = lim
        recs.append({"type": "assistant", "message": {
            "role": "assistant",
            "content": [{"type": "tool_use", "id": tid, "name": "Read",
                         "input": inp}],
            "usage": {"input_tokens": 0, "cache_creation_input_tokens": 0,
                      "cache_read_input_tokens": 20000, "output_tokens": 50}}})
        recs.append({"type": "user", "message": {
            "role": "user",
            "content": [{"type": "tool_result", "tool_use_id": tid,
                         "content": BODY}]}})
    with open(path, "w") as fh:
        for r in recs:
            fh.write(json.dumps(r) + "\n")


# A: disjoint ranges of one file (NOT copies), plus one true duplicate.
session(os.path.join(proj, "a.jsonl"), [
    ("/w/disjoint.py", 1, 50), ("/w/disjoint.py", 400, 50),
    ("/w/disjoint.py", 800, 50), ("/w/disjoint.py", 1200, 50),
    ("/w/dup.py", None, None), ("/w/dup.py", None, None),
])
# B: the SAME range as A read again, but in another session (NOT a copy --
#    this context has no prior copy of it and must read it).
session(os.path.join(proj, "b.jsonl"), [
    ("/w/disjoint.py", 1, 50), ("/w/dup.py", None, None),
])

f = Fleet.load(root=root)
per = {}
for s in f.sessions:
    for (p, o, l), (c, t) in s.reads.items():
        if c >= 2 and t > 0:
            per[(p, o, l)] = per.get((p, o, l), 0) + (t - t // c)

bad = []
disjoint = sum(v for (p, _o, _l), v in per.items() if p == "/w/disjoint.py")
dup = sum(v for (p, _o, _l), v in per.items() if p == "/w/dup.py")
if disjoint != 0:
    bad.append("four disjoint ranges of one file scored %d tokens of "
               "redundancy; distinct ranges are not copies" % disjoint)
if dup <= 0:
    bad.append("a genuine same-range duplicate scored %d -- the detector now "
               "misses what it is for" % dup)
# The cross-session repeat of /w/disjoint.py at 1+50 must not combine with A's.
key = ("/w/disjoint.py", 1, 50)
if per.get(key):
    bad.append("the same range read once in each of two sessions scored %d; "
               "redundancy was pooled across sessions again" % per[key])
print("|".join(bad) if bad else "CLEAR")
RR
)
[[ $rr == CLEAR ]] && ok "repeat-reads: distinct ranges and separate sessions are not copies" \
                   || bad "repeat-reads counts non-copies" "${rr//|/$'\n        '}"

# chatter/bulk cover the two Bash detectors and both cover preamble and
# session-length, which every long fixture trips.
covered+=(bash-chatter bash-bulk preamble session-length)
# mcp-schema depends on machine configuration (a custom base URL with tool
# deferral off), not on a transcript, so no fixture fleet can reach it. Named
# here rather than silently skipped, so the exemption is visible and has to be
# justified when someone reads this.
exempt=(mcp-schema)
uncovered=$(python3 - "${covered[*]}" "${exempt[*]}" "$ROOT" <<'COV'
import sys, os
sys.path.insert(0, os.path.join(sys.argv[3], "scripts", "lib"))
import advise
have = set(sys.argv[1].split()) | set(sys.argv[2].split())
print(" ".join(sorted(set(advise.CATALOGUE) - have)))
COV
)
if [[ -z $uncovered ]]; then
  ok "every detector in CATALOGUE is covered or explicitly exempt"
else
  bad "detectors with no fixture and no exemption" "$uncovered"
fi

# ---------------------------------------------------------------------------
head_ "6. VERSIONS  (four places that must agree)"
# ---------------------------------------------------------------------------
# The CLI, the plugin manifest, this repo's own marketplace entry and the git
# tag are read by four different consumers and drift silently. A v0.2.0 tag
# once pointed at a manifest saying 0.1.0; the marketplace entry then sat at
# 0.1.0 against a 0.3.0 manifest until `claude plugin validate` said so.
vres=$(python3 - "$ROOT" <<'VERCHK'
import json, os, re, subprocess, sys
root = sys.argv[1]
bad = []
manifest = json.load(open(os.path.join(root, ".claude-plugin", "plugin.json")))["version"]
cli = re.search(r'TS_VERSION="([^"]+)"', open(os.path.join(root, "scripts", "ts")).read()).group(1)
if manifest != cli:
    bad.append("plugin.json %s != scripts/ts %s" % (manifest, cli))
# This repo is also its own marketplace, for people who add it directly rather
# than through the org catalogue. That entry drifted once and `claude plugin
# validate` caught it when this check did not -- so it is checked here too,
# where it runs without the CLI installed.
mkt = os.path.join(root, ".claude-plugin", "marketplace.json")
if os.path.isfile(mkt):
    for entry in json.load(open(mkt)).get("plugins", []):
        if entry.get("version") and entry["version"] != manifest:
            bad.append("marketplace.json entry %r is %s but plugin.json says %s"
                       % (entry.get("name"), entry["version"], manifest))
# Only compare against a tag when the tree is clean. Mid-release the
# manifest is already bumped while HEAD still carries the PREVIOUS tag,
# and a check that fails during the normal release flow is a check people
# learn to ignore.
dirty = subprocess.run(["git", "-C", root, "status", "--porcelain"],
                       capture_output=True, text=True).stdout.strip()
if not dirty:
    tag = subprocess.run(["git", "-C", root, "tag", "--points-at", "HEAD"],
                         capture_output=True, text=True).stdout.split()
    tags = [t.lstrip("v") for t in tag if t.startswith("v")]
    if tags and manifest not in tags:
        bad.append("tag(s) %s at HEAD but plugin.json says %s"
                   % (",".join(tags), manifest))
print("|".join(bad))
VERCHK
)
if [[ -z $vres ]]; then
  ok "version agrees across plugin.json, scripts/ts and any tag at HEAD"
else
  bad "version drift" "${vres//|/$'\n        '}"
fi

# ---------------------------------------------------------------------------
head_ "7. REDACTION  (ts share must leak nothing)"
# ---------------------------------------------------------------------------
# A profile is meant to be sent to a stranger, so this plants identifying
# strings everywhere a transcript can carry them and asserts none survive.
# Spot-checking one machine's output proves nothing; a planted canary does.
leakdir="$TMP/leak/proj-CANARYPROJECT"
mkdir -p "$leakdir"
python3 - "$leakdir/CANARYSESSION.jsonl" <<'MKLEAK'
import json, sys
C = "CANARY7f3a"   # must not appear anywhere in the shared profile
u = {"input_tokens": 0, "cache_creation_input_tokens": 5000,
     "cache_read_input_tokens": 10000, "output_tokens": 50}
recs = []
for i in range(8):
    recs.append({"type": "assistant", "message": {"role": "assistant", "usage": u,
        "content": [{"type": "tool_use", "id": "t%d" % i, "name": "Bash",
                     "input": {"command": "cat /home/%s/secret_%s.txt" % (C, C)}}]}})
    recs.append({"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": "t%d" % i,
         "content": "contents of %s and more %s" % (C, C)}]}})
    recs.append({"type": "assistant", "message": {"role": "assistant", "usage": u,
        "content": [{"type": "tool_use", "id": "r%d" % i, "name": "Read",
                     "input": {"file_path": "/home/%s/%s.py" % (C, C)}}]}})
    recs.append({"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": "r%d" % i, "content": C * 200}]}})
    recs.append({"type": "assistant", "message": {"role": "assistant", "usage": u,
        "content": [{"type": "tool_use", "id": "m%d" % i,
                     "name": "mcp__%s__dothing" % C, "input": {"q": C}}]}})
    recs.append({"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": "m%d" % i, "content": C}]}})
with open(sys.argv[1], "w") as fh:
    for r in recs:
        fh.write(json.dumps(r) + "\n")
MKLEAK

if bounded 90 "$TS" share --root "$TMP/leak" --show >"$TMP/share.json" 2>"$TMP/share.err"; then
  hits=$(grep -o "CANARY7f3a\|CANARYPROJECT\|CANARYSESSION" "$TMP/share.json" | sort -u | tr '\n' ' ')
  if [[ -z $hits ]]; then
    ok "ts share: planted paths, commands, results and MCP names all redacted"
  else
    bad "ts share LEAKED identifying data" "found: $hits"
  fi
  python3 -c 'import json,sys; json.load(open(sys.argv[1]))' "$TMP/share.json" 2>/dev/null \
    && ok "ts share: emits valid JSON" \
    || bad "ts share: output is not valid JSON"
else
  bad "ts share failed" "$(head -3 "$TMP/share.err")"
fi

# ---------------------------------------------------------------------------
head_ "8. LIVE SIGNAL  (ts now)"
# ---------------------------------------------------------------------------
# Hand-derived, like the rest. Note the context of a turn is read+write+input
# -- the whole prompt that request paid for -- not the read alone. The bulk
# fixture's last turn reads 230,000 and writes 20,000, so context is 250,000;
# its first five turns bottom out at 10,000+20,000 = 30,000, the preamble.
# Break-even is then 1.25*30000 / (0.10*(250000-30000)) = 1.7045 turns.
# (Getting this wrong the first time is exactly what this check is for.)
sess=$(ls "$TMP"/bulk/proj-bulk/*.jsonl | head -1)
if bounded 60 "$TS" now --session "$sess" --json >"$TMP/now.json" 2>/dev/null; then
  res=$(python3 - "$TMP/now.json" <<'NOWCHK'
import json, sys
d = json.load(open(sys.argv[1]))
bad = []
if d["turns"] != 12:      bad.append("turns %s != 12" % d["turns"])
if d["context"] != 250000: bad.append("context %s != 250000" % d["context"])
if d["floor"] != 30000:   bad.append("floor %s != 30000" % d["floor"])
want = (1.25 * 30000) / (0.10 * (250000 - 30000))
if abs(d["breakeven_turns"] - want) > 1e-6:
    bad.append("breakeven %.4f != %.4f" % (d["breakeven_turns"], want))
print("|".join(bad))
NOWCHK
)
  if [[ -z $res ]]; then
    ok "ts now: context, preamble and break-even match hand arithmetic"
  else
    bad "ts now: wrong arithmetic" "${res//|/$'\n        '}"
  fi
else
  bad "ts now --json failed or timed out"
fi

# A session still at its preamble has nothing to gain, and must say so rather
# than printing a number that nags someone to clear a fresh session.
fresh="$TMP/fresh/proj/fresh.jsonl"
mkdir -p "$(dirname "$fresh")"
python3 - "$fresh" <<'MKFRESH'
import json, sys
u = {"input_tokens": 0, "cache_creation_input_tokens": 0,
     "cache_read_input_tokens": 10000, "output_tokens": 10}
with open(sys.argv[1], "w") as fh:
    for _ in range(6):
        fh.write(json.dumps({"type": "assistant", "message": {
            "role": "assistant", "content": [], "usage": u}}) + "\n")
MKFRESH
be=$(bounded 60 "$TS" now --session "$fresh" --json 2>/dev/null \
     | python3 -c 'import json,sys;print(json.load(sys.stdin)["breakeven_turns"])')
if [[ $be == None ]]; then
  ok "ts now: a session at its preamble reports no gain from clearing"
else
  bad "ts now: expected null break-even at the preamble, got $be"
fi

# Growth must survive a zero-inflated series. Context only jumps when a cache
# breakpoint moves, so roughly half of all real deltas are exactly zero -- and
# the median of that reads 0 on a session growing steadily. This fixture
# alternates 0 / +1000 across 20 turns: true growth is 500/turn.
burst="$TMP/burst/proj/burst.jsonl"
mkdir -p "$(dirname "$burst")"
python3 - "$burst" <<'MKBURST'
import json, sys
recs, ctx = [], 10000
for i in range(21):
    recs.append({"type": "assistant", "message": {"role": "assistant", "content": [],
        "usage": {"input_tokens": 0, "cache_creation_input_tokens": 0,
                  "cache_read_input_tokens": ctx, "output_tokens": 10}}})
    ctx += 1000 if i % 2 else 0
with open(sys.argv[1], "w") as fh:
    for r in recs:
        fh.write(json.dumps(r) + "\n")
MKBURST
g=$(bounded 30 "$TS" now --session "$burst" --json 2>/dev/null \
    | python3 -c 'import json,sys;print(int(round(json.load(sys.stdin)["growth_per_turn"])))')
if [[ $g == 500 ]]; then
  ok "ts now: growth survives a zero-inflated series (500/turn, not 0)"
else
  bad "ts now: growth on a bursty series was $g, expected 500"
fi

# --statusline runs inside a prompt: it must never hang, never write to stderr
# and never exit non-zero, whatever it is handed. The first version of this
# command hung forever on an idle stdin pipe, which is why this loop exists.
for label in empty garbage missing; do
  case $label in
    empty)   payload="" ;;
    garbage) payload="not json {{{" ;;
    missing) payload='{"transcript_path":"/nonexistent/x.jsonl"}' ;;
  esac
  if printf '%s' "$payload" | bounded 20 "$TS" now --statusline >"$TMP/sl.out" 2>"$TMP/sl.err"; then
    if [[ -s "$TMP/sl.err" ]]; then
      bad "ts now --statusline ($label stdin) wrote to stderr" "$(head -2 "$TMP/sl.err")"
    else
      ok "ts now --statusline: $label stdin handled silently"
    fi
  else
    bad "ts now --statusline ($label stdin) hung or exited non-zero"
  fi
done

# ---------------------------------------------------------------------------
printf '\n%s\n' "$(printf '%.0s-' {1..70})"
printf '  %s%d passed%s   %s%d failed%s   %d skipped\n' \
  "$GREEN" "$PASS" "$OFF" \
  "$( ((FAIL)) && printf '%s' "$RED" )" "$FAIL" "$OFF" "$SKIP"
[[ $KEEP == 1 ]] && printf '  %sfixtures kept in %s%s\n' "$DIM" "$TMP" "$OFF"
printf '\n'
exit $(( FAIL > 0 ))
