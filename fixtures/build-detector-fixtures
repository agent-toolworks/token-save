#!/usr/bin/env python3
"""One fixture fleet per detector, so every detector has something that fires it.

`build-fixtures` covers the two Bash detectors, because their mutual exclusion
is the central claim. This covers the rest: CONTRIBUTING asks a contributor to
add a profile that makes their detector fire, and that request is only fair if
the existing ones are held to it too.

Each profile is the smallest transcript that trips one detector's thresholds.
They are deliberately unrealistic — a fixture's job is to pin behaviour, and
`verify` asserts that the detector fires here and that its opposite does not.

Usage: fixtures/build-detector-fixtures [--out DIR]
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts", "lib"))

from transcripts import toks  # noqa: E402

FILL = "abcdefg hijklmn opqrst uvwxyz 0123456 789 "
_cache = {}


def text_of(n: int) -> str:
    """Exactly n tokens under whichever counter is installed. See build-fixtures."""
    if n <= 0:
        return ""
    if n in _cache:
        return _cache[n]
    s = FILL * (int(n * 6 / len(FILL)) + 2)
    while toks(s) < n:
        s += FILL
    while len(s) > 1 and toks(s[:-1]) >= n:
        s = s[:-1]
    _cache[n] = s
    return s


def usage(read, write=0, out=50):
    return {"input_tokens": 0, "cache_creation_input_tokens": write,
            "cache_read_input_tokens": read, "output_tokens": out}


def asst(u, blocks):
    return {"type": "assistant",
            "message": {"role": "assistant", "content": blocks, "usage": u}}


def result(tuid, content):
    return {"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": tuid, "content": content}]}}


def write_fleet(out, name, records):
    d = os.path.join(out, name, "proj")
    os.makedirs(d, exist_ok=True)
    with open(os.path.join(d, "s.jsonl"), "w") as fh:
        for r in records:
            fh.write(json.dumps(r) + "\n")


# --- profiles -------------------------------------------------------------

def p_verbose():
    """Huge output per turn -> output-verbosity (output is billed at 5x)."""
    recs, ctx = [], 20000
    for _ in range(40):
        recs.append(asst(usage(ctx, 500, 8000), [{"type": "text", "text": text_of(200)}]))
        ctx += 500
    return recs


def p_thinking():
    """Thinking blocks dominate content -> thinking."""
    recs, ctx = [], 20000
    for _ in range(30):
        recs.append(asst(usage(ctx, 500),
                         [{"type": "thinking", "thinking": text_of(2000)},
                          {"type": "text", "text": text_of(20)}]))
        ctx += 500
    return recs


def p_attachments():
    """Injected files dominate content -> attachments."""
    recs, ctx = [], 20000
    for _ in range(30):
        recs.append(asst(usage(ctx, 500), [{"type": "text", "text": text_of(20)}]))
        recs.append({"type": "attachment",
                     "attachment": {"kind": "file", "body": text_of(2000)}})
        ctx += 500
    return recs


def p_images():
    """Many screenshots -> images. A 1456x840 PNG header is ~1600 tokens."""
    # Minimal valid PNG header carrying real dimensions; image_tokens() reads it.
    import base64, struct
    raw = b"\x89PNG\r\n\x1a\n" + b"\x00" * 8 + struct.pack(">II", 1456, 840) + b"\x00" * 64
    b64 = base64.b64encode(raw).decode()
    recs, ctx = [], 20000
    for i in range(30):
        recs.append(asst(usage(ctx, 500),
                         [{"type": "tool_use", "id": "i%d" % i,
                           "name": "screenshot", "input": {}}]))
        recs.append({"type": "user", "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "i%d" % i, "content": [
                {"type": "image", "source": {"type": "base64", "data": b64}}]}]}})
        ctx += 500
    return recs


def p_rereads():
    """One file read over and over -> repeat-reads."""
    recs, ctx = [], 20000
    for i in range(12):
        recs.append(asst(usage(ctx, 500),
                         [{"type": "tool_use", "id": "r%d" % i, "name": "Read",
                           "input": {"file_path": "/src/hot.py"}}]))
        recs.append(result("r%d" % i, text_of(1500)))
        ctx += 500
    return recs


PROFILES = {
    "verbose": (p_verbose, "output-verbosity"),
    "thinking": (p_thinking, "thinking"),
    "attachments": (p_attachments, "attachments"),
    "images": (p_images, "images"),
    "rereads": (p_rereads, "repeat-reads"),
}


def main(argv=None) -> int:
    here = os.path.dirname(os.path.abspath(__file__))
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default=here)
    args = ap.parse_args(argv)
    for name, (fn, detector) in PROFILES.items():
        d = os.path.join(args.out, name)
        if os.path.isdir(d):
            shutil.rmtree(d)
        write_fleet(args.out, name, fn())
        print("  %-14s -> expects %s" % (name, detector))
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
