#!/usr/bin/env python3
"""Generate deterministic transcript fixtures with known-correct answers.

Two fleets, built to be opposites, because the central claim of this tool is
that the same catalogue gives different advice to different machines. If both
fleets produced the same findings, the claim would be false and `verify` says
so.

  chatter/  many small Bash calls        -> bash-chatter fires, bash-bulk must not
  bulk/     few enormous Bash outputs    -> bash-bulk fires, bash-chatter must not

Numbers are chosen so the expected values can be worked out by hand and written
into EXPECTATIONS.json, rather than recorded from whatever the code happened to
print — a self-test that records its own output tests nothing.

Usage: fixtures/build-fixtures [--out DIR]
"""
from __future__ import annotations

import argparse
import json
import os
import shutil
import sys

sys.path.insert(0, os.path.join(
    os.path.dirname(os.path.dirname(os.path.abspath(__file__))), "scripts", "lib"))

from transcripts import toks  # noqa: E402

# Deterministic filler. Its character-to-token ratio differs between the
# estimator and tiktoken, which is precisely why text_of() below measures
# rather than assuming: a fixture asserted in TOKENS must be generated in
# tokens, or the expectations only hold under whichever counter happened to be
# installed when they were written. (That bug was real; the dual-tokenizer CI
# matrix is what caught it.)
FILL = "abcdefg hijklmn opqrst uvwxyz 0123456 789 "

_cache = {}


def text_of(target_tokens: int) -> str:
    """A string of exactly `target_tokens` tokens under the ACTIVE counter.

    Grows past the target, then trims one character at a time. Slow in
    principle, trivial in practice: fixtures use a handful of distinct sizes
    and the results are memoised.
    """
    if target_tokens in _cache:
        return _cache[target_tokens]
    if target_tokens <= 0:
        return ""
    s = FILL * (int(target_tokens * 6 / len(FILL)) + 2)
    while toks(s) < target_tokens:
        s += FILL
    while len(s) > 1 and toks(s[:-1]) >= target_tokens:
        s = s[:-1]
    _cache[target_tokens] = s
    return s


def rec_user_text(s):
    return {"type": "user", "message": {"role": "user", "content": s}}


def rec_assistant(usage, blocks, mid=None):
    m = {"role": "assistant", "content": blocks, "usage": usage}
    if mid:
        m["id"] = mid
    return {"type": "assistant", "message": m}


def rec_assistant_split(usage, block_lists, mid):
    """One MESSAGE written as several transcript LINES, as the real format does.

    Every line repeats the same usage object, inputs byte-identical and
    output_tokens growing to the total on the last line. Counting per line
    inflated every billed figure by the number of content blocks -- 1.86x on
    one machine, 2.19x on another -- and no hand-built fixture had this shape,
    so nothing caught it.
    """
    out, n = [], len(block_lists)
    for i, blocks in enumerate(block_lists):
        u = dict(usage)
        # Partial on every line but the last; the last carries the total.
        u["output_tokens"] = usage["output_tokens"] if i == n - 1 else 1
        out.append(rec_assistant(u, blocks, mid=mid))
    return out


def rec_tool_result(tuid, body):
    return {"type": "user", "message": {"role": "user", "content": [
        {"type": "tool_result", "tool_use_id": tuid, "content": body}]}}


def usage(cache_read, cache_write=0, out=100):
    return {"input_tokens": 0,
            "cache_creation_input_tokens": cache_write,
            "cache_read_input_tokens": cache_read,
            "output_tokens": out}


def write(path, records):
    os.makedirs(os.path.dirname(path), exist_ok=True)
    with open(path, "w") as fh:
        for r in records:
            fh.write(json.dumps(r) + "\n")


def chatter_session(idx: int, calls: int = 120):
    """Small Bash outputs, high call count. Preamble 10,000; +1,000/turn."""
    recs = [rec_user_text(text_of(20))]
    ctx = 10000
    for i in range(calls):
        tuid = "c%d_%d" % (idx, i)
        recs.append(rec_assistant(
            usage(ctx, 1000, 80),
            [{"type": "tool_use", "id": tuid, "name": "Bash",
              "input": {"command": "cd /a/very/long/project/path && "
                                   + text_of(30)}}]))
        recs.append(rec_tool_result(tuid, text_of(100)))
        ctx += 1000
    return recs


def bulk_session(idx: int, calls: int = 12):
    """Few, enormous Bash outputs. Preamble 10,000; +20,000/turn."""
    recs = [rec_user_text(text_of(20))]
    ctx = 10000
    for i in range(calls):
        tuid = "b%d_%d" % (idx, i)
        recs.append(rec_assistant(
            usage(ctx, 20000, 80),
            [{"type": "tool_use", "id": tuid, "name": "Bash",
              "input": {"command": "npm run build"}}]))
        recs.append(rec_tool_result(tuid, text_of(20000)))
        ctx += 20000
    return recs


def split_session():
    """One session of 5 messages, each split across 3 lines.

    Correct totals, by hand: 5 messages x (cache_read 10,000, cache_write 500,
    output 300). Counting per line would give 15 turns and 3x every figure.
    """
    recs = [rec_user_text(text_of(20))]
    for i in range(5):
        recs.extend(rec_assistant_split(
            usage(10000, 500, 300),
            [[{"type": "text", "text": text_of(10)}],
             [{"type": "tool_use", "id": "s%d_a" % i, "name": "Bash",
               "input": {"command": "echo a"}}],
             [{"type": "tool_use", "id": "s%d_b" % i, "name": "Bash",
               "input": {"command": "echo b"}}]],
            mid="msg_%d" % i))
        recs.append(rec_tool_result("s%d_a" % i, text_of(50)))
        recs.append(rec_tool_result("s%d_b" % i, text_of(50)))
    return recs


def main(argv=None) -> int:
    here = os.path.dirname(os.path.abspath(__file__))
    ap = argparse.ArgumentParser()
    ap.add_argument("--out", default=here)
    args = ap.parse_args(argv)

    for name in ("chatter", "bulk", "split"):
        d = os.path.join(args.out, name)
        if os.path.isdir(d):
            shutil.rmtree(d)

    for i in range(3):
        write(os.path.join(args.out, "chatter", "proj-chatter",
                           "session-%d.jsonl" % i), chatter_session(i))
    for i in range(3):
        write(os.path.join(args.out, "bulk", "proj-bulk",
                           "session-%d.jsonl" % i), bulk_session(i))
    write(os.path.join(args.out, "split", "proj-split", "s.jsonl"), split_session())

    print("wrote fixtures under %s" % args.out)
    print("  chatter/  3 sessions x 120 Bash calls, ~100 token outputs")
    print("  bulk/     3 sessions x  12 Bash calls, ~20,000 token outputs")
    print("  split/    5 messages x 3 transcript lines each (the real format)")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
