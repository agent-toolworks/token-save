#!/usr/bin/env python3
"""token-save's source for toolworks-hub.

The hub finds this folder inside the installed plugin and runs `run detect`,
`run fetch <widget>` and `run show session <id>`, each printing JSON in the
shapes its source contract (version 3) defines. Version 2 is what lets a
quota say when it resets (resets_at), which the hub counts down to; version
3 lets the quota-history chart offer its time ranges (6h to 30d) as buttons.

It reads the history the statusline records exactly as docs/history-schema.md
tells a reader to: found by history.db_path(), the writer's own lookup;
opened read-only with a busy timeout; columns selected by name; a session's
totals taken from its latest row, never summed across rows. The current
quota comes from limits.json, through limits.read(). Nothing here writes.

detect reports `stale` from the same on-disk check `ts doctor` makes
(machine.plugin_installs), so the hub and the doctor never disagree.
"""
import json
import os
import re
import sqlite3
import sys
import urllib.parse
from datetime import datetime, timedelta, timezone

ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, os.path.join(ROOT, "scripts", "lib"))

import history  # noqa: E402
import limits  # noqa: E402
import machine  # noqa: E402

NEEDS_SCHEMA = 2  # rate_limits_observed_at and source arrived in schema 2
DAYS = 30
RECENT = 20
TS = os.path.join(ROOT, "scripts", "ts")
# Only a Claude Code session ID can link to the hub's session page; anything
# else (an imported row from another recorder, say) stays plain text.
UUID = re.compile(r"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")

LATEST = """
WITH ranked AS (
  SELECT session_id, recorded_at, project_dir, model_name,
         lines_added, lines_removed,
         row_number() OVER (PARTITION BY session_id ORDER BY recorded_at DESC, id DESC) AS n,
         min(recorded_at) OVER (PARTITION BY session_id) AS started
  FROM snapshots)
SELECT session_id, recorded_at, project_dir, model_name,
       lines_added, lines_removed, started
FROM ranked WHERE n = 1
"""


def out(value):
    json.dump(value, sys.stdout)
    sys.stdout.write("\n")


def version():
    with open(os.path.join(ROOT, ".claude-plugin", "plugin.json"), encoding="utf-8") as f:
        return json.load(f)["version"]


def connect(path):
    uri = "file:%s?mode=ro" % urllib.parse.quote(path)
    db = sqlite3.connect(uri, uri=True, timeout=1.0)
    db.row_factory = sqlite3.Row
    return db


def utc(dt):
    return dt.astimezone(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def local(text):
    """A history time (UTC, ISO 8601) as local time, for a person."""
    try:
        return datetime.fromisoformat(text.replace("Z", "+00:00")).astimezone().strftime("%Y-%m-%d %H:%M")
    except (ValueError, AttributeError):
        return text


def session_cell(sid):
    return {"ref": "session", "id": sid, "label": sid[:8]} if UUID.match(sid or "") else sid


def detect():
    path = history.db_path()
    if path is None:
        return out({"state": "off", "reason": "recording is off (TS_HISTORY is set to off)"})
    if not os.path.isfile(path):
        return out({"state": "not_set_up", "reason": "nothing recorded yet: there is no history at %s" % path,
                    "fix": "%s fixes apply statusline, then restart Claude Code" % TS})
    try:
        db = connect(path)
        schema = db.execute("PRAGMA user_version").fetchone()[0]
        db.execute("SELECT 1 FROM snapshots LIMIT 1").fetchall()
        db.close()
    except sqlite3.Error as e:
        return out({"state": "broken", "reason": "the history at %s could not be read (%s)" % (path, e)})
    if schema < NEEDS_SCHEMA:
        return out({"state": "incompatible",
                    "reason": "the history is schema %d; this needs %d or later" % (schema, NEEDS_SCHEMA),
                    "fix": "open Claude Code: the statusline upgrades the history on its next render"})
    ver = version()
    stale = machine.plugin_installs(ROOT, ver)["stale"]
    if stale:
        return out({"state": "stale", "reason": stale[0], "tool_version": ver,
                    "fix": "claude plugin update token-save, then restart Claude Code"})
    out({"state": "working", "tool_version": ver})


def quota(window):
    """One quota window from limits.json, or why there is no reading."""
    entry = limits.read().get(window)
    if not isinstance(entry, dict) or entry.get("used_percentage") is None:
        return out({"kind": "stat", "data": {"value": "—", "label": "not observed yet"}})
    resets = entry.get("resets_at")
    now = datetime.now(timezone.utc).timestamp()
    if isinstance(resets, (int, float)) and resets <= now:
        when = datetime.fromtimestamp(resets).astimezone().strftime("%Y-%m-%d %H:%M")
        return out({"kind": "stat", "data": {"value": "—", "label": "the window reset at %s; no reading since" % when}})
    label = "used"
    if isinstance(resets, (int, float)):
        label = "used; resets %s" % datetime.fromtimestamp(resets).astimezone().strftime("%a %H:%M")
    result = {"kind": "stat", "data": {"value": round(entry["used_percentage"]), "unit": "%", "label": label}}
    if isinstance(resets, (int, float)):
        result["data"]["resets_at"] = utc(datetime.fromtimestamp(resets, timezone.utc))
    if isinstance(entry.get("observed_at"), str):
        result["as_of"] = entry["observed_at"]
    out(result)


def sessions(db):
    rows = db.execute("SELECT * FROM (%s) ORDER BY recorded_at DESC LIMIT ?" % LATEST, (RECENT,)).fetchall()
    out({"kind": "table", "data": {
        "columns": [
            {"id": "session", "title": "Session"},
            {"id": "project", "title": "Project"},
            {"id": "model", "title": "Model"},
            {"id": "lines", "title": "Lines"},
            {"id": "last", "title": "Last recorded"},
        ],
        "rows": [{
            "session": session_cell(r["session_id"]),
            "project": r["project_dir"],
            "model": r["model_name"],
            "lines": None if r["lines_added"] is None else "+%d −%d" % (r["lines_added"], r["lines_removed"] or 0),
            "last": local(r["recorded_at"]),
        } for r in rows],
    }})


def projects(db):
    first = (datetime.now(timezone.utc).date() - timedelta(days=DAYS - 1)).isoformat()
    rows = db.execute("SELECT project_dir, count(*) AS sessions FROM (%s) "
                      "WHERE started >= ? GROUP BY project_dir ORDER BY sessions DESC, project_dir LIMIT 15" % LATEST,
                      (first,)).fetchall()
    out({"kind": "table", "data": {
        "columns": [
            {"id": "project", "title": "Project"},
            {"id": "sessions", "title": "Sessions"},
        ],
        "rows": [{"project": r["project_dir"], "sessions": r["sessions"]} for r in rows],
    }})


def show_session(db, sid):
    rows = db.execute("SELECT recorded_at, model_name, effort, project_dir, git_branch, "
                      "lines_added, lines_removed, duration_ms, ctx_pct, prompt_cache_hit_ratio "
                      "FROM snapshots WHERE session_id = ? ORDER BY recorded_at, id", (sid,)).fetchall()
    if not rows:
        return out({"widgets": []})
    last = rows[-1]
    peak = max((r["ctx_pct"] for r in rows if r["ctx_pct"] is not None), default=None)
    facts = [
        ("Model", " ".join(x for x in (last["model_name"], last["effort"] and "(%s)" % last["effort"]) if x)),
        ("Project", last["project_dir"]),
        ("Branch", last["git_branch"]),
        ("Lines", None if last["lines_added"] is None
         else "+%d −%d" % (last["lines_added"], last["lines_removed"] or 0)),
        ("Duration", None if last["duration_ms"] is None else "%d min" % round(last["duration_ms"] / 60000)),
        ("Peak context used", None if peak is None else "%d%%" % round(peak)),
        ("Prompt cache hit ratio", None if last["prompt_cache_hit_ratio"] is None
         else "%d%%" % round(last["prompt_cache_hit_ratio"] * 100)),
    ]
    out({"widgets": [
        {"id": "details", "kind": "list", "title": "From token-save's history",
         "data": {"items": [{"text": k, "detail": v} for k, v in facts if v]}},
    ]})


BUCKET = 600         # seconds: one quota-history point per 10 minutes
GAP = 3600           # seconds without a reading that break the line
HISTORY_DAYS = 30    # the longest range the hub offers


def quota_history(db):
    """The 5-hour and 7-day quota over the last 30 days, one chart.

    From observed readings only (rate_limits_observed_at set), true as of that
    time, as docs/history-schema.md says: an idle session keeps writing an old
    reading, which only rows with a fresh observation leave out. The quota is
    the account's, so sessions are not added together; each 10-minute bucket
    takes the highest reading seen in it (a window can reset inside one). An
    hour with no reading breaks the line rather than drawing across it.
    """
    since = utc(datetime.now(timezone.utc) - timedelta(days=HISTORY_DAYS))
    rows = db.execute("SELECT rate_limits_observed_at AS t, five_hour_pct, seven_day_pct FROM snapshots "
                      "WHERE rate_limits_observed_at >= ? ORDER BY rate_limits_observed_at", (since,)).fetchall()
    buckets = {}
    for r in rows:
        try:
            ts = datetime.fromisoformat(r["t"].replace("Z", "+00:00")).timestamp()
        except (AttributeError, ValueError):
            continue
        b = buckets.setdefault(int(ts // BUCKET) * BUCKET, [None, None])
        for i, v in enumerate((r["five_hour_pct"], r["seven_day_pct"])):
            if v is not None and (b[i] is None or v > b[i]):
                b[i] = v
    series = [{"name": "5h", "points": []}, {"name": "7d", "points": []}]
    previous = None
    for start in sorted(buckets):
        t = utc(datetime.fromtimestamp(start, timezone.utc))
        for i, s in enumerate(series):
            if previous is not None and start - previous > GAP:
                s["points"].append({"t": utc(datetime.fromtimestamp(previous + BUCKET, timezone.utc)), "v": None})
            v = buckets[start][i]
            s["points"].append({"t": t, "v": None if v is None else round(v, 1)})
        previous = start
    result = {"kind": "timeseries", "data": {"unit": "%", "series": series}}
    if rows:
        result["as_of"] = rows[-1]["t"]
    out(result)


WIDGETS = {"sessions": sessions, "projects": projects, "quota-history": quota_history}


def main(argv):
    cmd = argv[1:]
    if cmd == ["detect"]:
        return detect()
    if cmd[:1] == ["fetch"] and len(cmd) == 2 and cmd[1] in ("five-hour", "seven-day"):
        return quota(cmd[1].replace("-", "_"))
    if (cmd[:1] == ["fetch"] and len(cmd) == 2 and cmd[1] in WIDGETS) or \
            (cmd[:2] == ["show", "session"] and len(cmd) == 3):
        path = history.db_path()
        if path is None or not os.path.isfile(path):
            print("no history to read; run detect", file=sys.stderr)
            sys.exit(1)
        db = connect(path)
        try:
            return WIDGETS[cmd[1]](db) if cmd[0] == "fetch" else show_session(db, cmd[2])
        finally:
            db.close()
    print("unknown command: %s" % " ".join(cmd), file=sys.stderr)
    sys.exit(2)


if __name__ == "__main__":
    main(sys.argv)
